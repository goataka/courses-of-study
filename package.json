{
  "name": "courses-of-study",
  "private": true,
  "description": "学習指導要領の学習内容を Markdown で段階ごとに整理したもの",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test && pnpm run check:docs",
    "check:docs": "node tools/check.ts",
    "test": "node --test \"tools/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
