{
  "id": "math-g4",
  "subject": "math",
  "grades": [4],
  "name": "第4学年",
  "code": "8250240000000000",
  "goals": [
    {"id": "math-g4-goal-1", "code": "8250242100000000", "no": "(1)", "kind": "goal", "category": "knowledge", "text": "小数と分数の意味と表し方、四則の関係、平面図形と立体図形、面積、角の大きさ、折れ線グラフなどを理解する。整数、小数、分数の計算、図形の構成、図形の面積や角の大きさの求め方、表やグラフへの表現などの技能を身に付ける"},
    {"id": "math-g4-goal-2", "code": "8250242200000000", "no": "(2)", "kind": "goal", "category": "thinking", "text": "数とその表現や数量の関係に着目し、目的に合った表現方法を用いて計算の仕方を考察する力を養う。図形の構成要素とその位置関係に着目し、図形の性質や計量を考察する力を養う。伴って変わる二つの数量やその関係に着目し、変化や対応の特徴を見いだして、二つの数量の関係を表や式を用いて考察する力を養う。目的に応じてデータを収集し、データの特徴や傾向に着目して表やグラフに的確に表現し、それらを用いて問題解決したり、解決の過程や結果を多面的に捉え考察したりする力を養う"},
    {"id": "math-g4-goal-3", "code": "8250242300000000", "no": "(3)", "kind": "goal", "category": "attitude", "text": "数学的に表現し処理したことを振り返り、多面的に捉え検討して、よりよいものを求めて粘り強く考える態度を養う。数学のよさに気付き、学習したことを生活や学習に活用しようとする態度を養う"}
  ],
  "contents": [
    {"id": "math-g4-A", "code": "8250243100000000", "no": "A", "kind": "section", "title": "数と計算", "children": [
      {"id": "math-g4-A-1", "code": "8250243110000000", "no": "(1)", "kind": "section", "title": "整数の表し方", "children": [
        {"id": "math-g4-A-1-a-a", "code": "8250243111100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "億、兆の単位を知り、十進位取り記数法の理解を深める", "keywords": ["億", "兆", "十進位取り記数法"]},
        {"id": "math-g4-A-1-i-a", "code": "8250243112100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数のまとまりに着目し、大きな数の大きさの比べ方や表し方を統合的に捉え、日常生活に生かす"}
      ]},
      {"id": "math-g4-A-2", "code": "8250243120000000", "no": "(2)", "kind": "section", "title": "概数", "children": [
        {"id": "math-g4-A-2-a-a", "code": "8250243121100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "概数が用いられる場合を知る", "keywords": ["概数"]},
        {"id": "math-g4-A-2-a-i", "code": "8250243121200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "四捨五入を知る", "keywords": ["四捨五入"]},
        {"id": "math-g4-A-2-a-u", "code": "8250243121300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "目的に応じて、四則計算の結果の見積りをする", "keywords": ["見積り"]},
        {"id": "math-g4-A-2-i-a", "code": "8250243122100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "日常の事象における場面に着目し、目的に合った数の処理の仕方を考え、日常生活に生かす"}
      ]},
      {"id": "math-g4-A-3", "code": "8250243130000000", "no": "(3)", "kind": "section", "title": "整数の除法", "children": [
        {"id": "math-g4-A-3-a-a", "code": "8250243131100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "除数が1位数や2位数で、被除数が2位数や3位数の場合の除法の計算が、基本的な計算を基にしてできることを理解する。その筆算の仕方を理解する", "keywords": ["除法", "筆算"]},
        {"id": "math-g4-A-3-a-i", "code": "8250243131200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "除法の計算が確実にでき、適切に用いる"},
        {"id": "math-g4-A-3-a-u", "code": "8250243131300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "除法について、被除数＝除数×商＋余り の関係を理解する"},
        {"id": "math-g4-A-3-a-e", "code": "8250243131400000", "no": "ア(エ)", "kind": "item", "category": "knowledge", "text": "除法に関して成り立つ性質を理解する"},
        {"id": "math-g4-A-3-i-a", "code": "8250243132100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数量の関係に着目し、計算の仕方を考え、計算に関して成り立つ性質を見いだす。その性質を活用して、計算を工夫したり計算の確かめをしたりする"}
      ]},
      {"id": "math-g4-A-4", "code": "8250243140000000", "no": "(4)", "kind": "section", "title": "小数とその計算", "children": [
        {"id": "math-g4-A-4-a-a", "code": "8250243141100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "ある量の何倍かを表すのに小数を用いることを知る", "keywords": ["小数"]},
        {"id": "math-g4-A-4-a-i", "code": "8250243141200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "小数が整数と同じ仕組みで表されていることを知り、数の相対的な大きさの理解を深める"},
        {"id": "math-g4-A-4-a-u", "code": "8250243141300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "小数の加法と減法の計算ができる"},
        {"id": "math-g4-A-4-a-e", "code": "8250243141400000", "no": "ア(エ)", "kind": "item", "category": "knowledge", "text": "乗数や除数が整数である場合の、小数の乗法と除法の計算ができる", "keywords": ["乗数や除数が整数"]},
        {"id": "math-g4-A-4-i-a", "code": "8250243142100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数の表し方の仕組みや数を構成する単位に着目し、計算の仕方を考え、日常生活に生かす"}
      ]},
      {"id": "math-g4-A-5", "code": "8250243150000000", "no": "(5)", "kind": "section", "title": "分数とその加法及び減法", "children": [
        {"id": "math-g4-A-5-a-a", "code": "8250243151100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "簡単な場合について、大きさの等しい分数があることを知る", "keywords": ["大きさの等しい分数"]},
        {"id": "math-g4-A-5-a-i", "code": "8250243151200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "同分母の分数の加法と減法の計算ができる", "keywords": ["同分母の分数"]},
        {"id": "math-g4-A-5-i-a", "code": "8250243152100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数を構成する単位に着目し、大きさの等しい分数を探したり計算の仕方を考えたりし、日常生活に生かす"}
      ]},
      {"id": "math-g4-A-6", "code": "8250243160000000", "no": "(6)", "kind": "section", "title": "数量の関係を表す式", "children": [
        {"id": "math-g4-A-6-a-a", "code": "8250243161100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "四則の混合した式や、かっこを用いた式を理解し、正しく計算する", "keywords": ["四則の混合した式"]},
        {"id": "math-g4-A-6-a-i", "code": "8250243161200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "公式についての考え方を理解し、公式を用いる", "keywords": ["公式"]},
        {"id": "math-g4-A-6-a-u", "code": "8250243161300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "数量を□、△などを用いて表し、その関係を式に表したり、□、△などに数を当てはめて調べたりする"},
        {"id": "math-g4-A-6-i-a", "code": "8250243162100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "問題場面の数量の関係に着目し、数量の関係を簡潔に、また一般的に表現したり、式の意味を読み取ったりする"}
      ]},
      {"id": "math-g4-A-7", "code": "8250243170000000", "no": "(7)", "kind": "section", "title": "計算に関して成り立つ性質", "children": [
        {"id": "math-g4-A-7-a-a", "code": "8250243171100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "四則に関して成り立つ性質の理解を深める"},
        {"id": "math-g4-A-7-i-a", "code": "8250243172100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数量の関係に着目し、計算に関して成り立つ性質を用いて計算の仕方を考える"}
      ]},
      {"id": "math-g4-A-8", "code": "8250243180000000", "no": "(8)", "kind": "section", "title": "そろばんを用いた数の表し方と計算", "children": [
        {"id": "math-g4-A-8-a-a", "code": "8250243181100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "そろばんを用いて、加法と減法の計算をする", "keywords": ["そろばん"]},
        {"id": "math-g4-A-8-i-a", "code": "8250243182100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "そろばんの仕組みに着目し、大きな数や小数の計算の仕方を考える"}
      ]}
    ]},
    {"id": "math-g4-B", "code": "8250243200000000", "no": "B", "kind": "section", "title": "図形", "children": [
      {"id": "math-g4-B-1", "code": "8250243210000000", "no": "(1)", "kind": "section", "title": "平面図形", "children": [
        {"id": "math-g4-B-1-a-a", "code": "8250243211100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "直線の平行や垂直の関係を理解する", "keywords": ["平行", "垂直"]},
        {"id": "math-g4-B-1-a-i", "code": "8250243211200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "平行四辺形、ひし形、台形を知る", "keywords": ["平行四辺形", "ひし形", "台形"]},
        {"id": "math-g4-B-1-i-a", "code": "8250243212100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "図形の構成要素とその位置関係に着目し、構成の仕方を考察して図形の性質を見いだす。その性質を基に、既習の図形を捉え直す"}
      ]},
      {"id": "math-g4-B-2", "code": "8250243220000000", "no": "(2)", "kind": "section", "title": "立体図形", "children": [
        {"id": "math-g4-B-2-a-a", "code": "8250243221100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "立方体、直方体を知る", "keywords": ["立方体", "直方体"]},
        {"id": "math-g4-B-2-a-i", "code": "8250243221200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "直方体に関連して、直線や平面の平行や垂直の関係を理解する"},
        {"id": "math-g4-B-2-a-u", "code": "8250243221300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "見取図、展開図を知る", "keywords": ["見取図", "展開図"]},
        {"id": "math-g4-B-2-i-a", "code": "8250243222100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "図形の構成要素とその位置関係に着目し、立体図形の平面上での表現や構成の仕方を考察して図形の性質を見いだす。日常の事象を図形の性質から捉え直す"}
      ]},
      {"id": "math-g4-B-3", "code": "8250243230000000", "no": "(3)", "kind": "section", "title": "ものの位置", "children": [
        {"id": "math-g4-B-3-a-a", "code": "8250243231100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "ものの位置の表し方を理解する", "keywords": ["ものの位置"]},
        {"id": "math-g4-B-3-i-a", "code": "8250243232100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "平面や空間における位置を決める要素に着目し、その位置を数を用いて表現する方法を考察する"}
      ]},
      {"id": "math-g4-B-4", "code": "8250243240000000", "no": "(4)", "kind": "section", "title": "平面図形の面積", "children": [
        {"id": "math-g4-B-4-a-a", "code": "8250243241100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "面積の単位の平方センチメートル cm²、平方メートル m²、平方キロメートル km² を知る", "keywords": ["面積の単位"]},
        {"id": "math-g4-B-4-a-i", "code": "8250243241200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "正方形と長方形の面積の、計算による求め方を理解する", "keywords": ["正方形と長方形の面積"]},
        {"id": "math-g4-B-4-i-a", "code": "8250243242100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "面積の単位や図形の構成要素に着目し、図形の面積の求め方を考える。面積の単位と、これまでに学習した単位との関係を考察する"}
      ]},
      {"id": "math-g4-B-5", "code": "8250243250000000", "no": "(5)", "kind": "section", "title": "角の大きさ", "children": [
        {"id": "math-g4-B-5-a-a", "code": "8250243251100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "角の大きさを回転の大きさとして捉える", "keywords": ["角の大きさ"]},
        {"id": "math-g4-B-5-a-i", "code": "8250243251200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "角の大きさの単位の度 ° を知り、角の大きさを測定する", "keywords": ["度"]},
        {"id": "math-g4-B-5-i-a", "code": "8250243252100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "図形の角の大きさに着目し、角の大きさを柔軟に表現したり、図形の考察に生かしたりする"}
      ]}
    ]},
    {"id": "math-g4-C", "code": "8250243300000000", "no": "C", "kind": "section", "title": "変化と関係", "children": [
      {"id": "math-g4-C-1", "code": "8250243310000000", "no": "(1)", "kind": "section", "title": "伴って変わる二つの数量", "children": [
        {"id": "math-g4-C-1-a-a", "code": "8250243311100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "変化の様子を表や式、折れ線グラフを用いて表したり、変化の特徴を読み取ったりする", "keywords": ["折れ線グラフ"]},
        {"id": "math-g4-C-1-i-a", "code": "8250243312100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "伴って変わる二つの数量を見いだして、それらの関係に着目し、表や式を用いて変化や対応の特徴を考察する", "keywords": ["伴って変わる二つの数量"]}
      ]},
      {"id": "math-g4-C-2", "code": "8250243320000000", "no": "(2)", "kind": "section", "title": "二つの数量の関係", "children": [
        {"id": "math-g4-C-2-a-a", "code": "8250243321100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "簡単な場合について、ある二つの数量の関係と別の二つの数量の関係とを比べる場合に、割合を用いる場合があることを知る", "keywords": ["割合"]},
        {"id": "math-g4-C-2-i-a", "code": "8250243322100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "日常の事象における数量の関係に着目し、図や式などを用いて、ある二つの数量の関係と別の二つの数量の関係との比べ方を考察する"}
      ]}
    ]},
    {"id": "math-g4-D", "code": "8250243400000000", "no": "D", "kind": "section", "title": "データの活用", "children": [
      {"id": "math-g4-D-1", "code": "8250243410000000", "no": "(1)", "kind": "section", "title": "データの収集とその分析", "children": [
        {"id": "math-g4-D-1-a-a", "code": "8250243411100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "データを二つの観点から分類整理する方法を知る", "keywords": ["二つの観点"]},
        {"id": "math-g4-D-1-a-i", "code": "8250243411200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "折れ線グラフの特徴と用い方を理解する", "keywords": ["折れ線グラフ"]},
        {"id": "math-g4-D-1-i-a", "code": "8250243412100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "目的に応じてデータを集めて分類整理し、データの特徴や傾向に着目する。問題を解決するために適切なグラフを選択して判断し、その結論について考察する"}
      ]}
    ]},
    {"id": "math-g4-activity", "code": "8250243500000000", "no": "", "kind": "section", "title": "数学的活動", "children": [
      {"id": "math-g4-activity-1-a", "code": "8250243511000000", "no": "(1)ア", "kind": "activity", "text": "日常の事象から算数の問題を見いだして解決し、結果を確かめたり、日常生活などに生かしたりする活動"},
      {"id": "math-g4-activity-1-i", "code": "8250243512000000", "no": "(1)イ", "kind": "activity", "text": "算数の学習場面から算数の問題を見いだして解決し、結果を確かめたり、発展的に考察したりする活動"},
      {"id": "math-g4-activity-1-u", "code": "8250243513000000", "no": "(1)ウ", "kind": "activity", "text": "問題解決の過程や結果を、図や式などを用いて数学的に表現し伝え合う活動"}
    ]},
    {"id": "math-g4-terms", "code": "8250243600000000", "no": "", "kind": "section", "title": "用語・記号", "children": [
      {"id": "math-g4-terms-1", "code": "8250243601000000", "no": "", "kind": "term", "text": "和"},
      {"id": "math-g4-terms-2", "code": "8250243602000000", "no": "", "kind": "term", "text": "差"},
      {"id": "math-g4-terms-3", "code": "8250243603000000", "no": "", "kind": "term", "text": "積"},
      {"id": "math-g4-terms-4", "code": "8250243604000000", "no": "", "kind": "term", "text": "商"},
      {"id": "math-g4-terms-5", "code": "8250243605000000", "no": "", "kind": "term", "text": "以上"},
      {"id": "math-g4-terms-6", "code": "8250243606000000", "no": "", "kind": "term", "text": "以下"},
      {"id": "math-g4-terms-7", "code": "8250243607000000", "no": "", "kind": "term", "text": "未満"},
      {"id": "math-g4-terms-8", "code": "8250243608000000", "no": "", "kind": "term", "text": "真分数"},
      {"id": "math-g4-terms-9", "code": "8250243609000000", "no": "", "kind": "term", "text": "仮分数"},
      {"id": "math-g4-terms-10", "code": "8250243610000000", "no": "", "kind": "term", "text": "帯分数"},
      {"id": "math-g4-terms-11", "code": "8250243611000000", "no": "", "kind": "term", "text": "平行"},
      {"id": "math-g4-terms-12", "code": "8250243612000000", "no": "", "kind": "term", "text": "垂直"},
      {"id": "math-g4-terms-13", "code": "8250243613000000", "no": "", "kind": "term", "text": "対角線"},
      {"id": "math-g4-terms-14", "code": "8250243614000000", "no": "", "kind": "term", "text": "平面"}
    ]}
  ],
  "handling": [
    {"id": "math-g4-handling-1", "code": "8250245100000000", "no": "(1)", "kind": "handling", "text": "大きな数を表す際に、3桁ごとに区切りを用いる場合があることに触れる", "keywords": ["3桁ごとに区切り"], "refs": ["math-g4-A-1"]},
    {"id": "math-g4-handling-2", "code": "8250245200000000", "no": "(2)", "kind": "handling", "text": "簡単な計算は暗算でできるよう配慮する。暗算を筆算や見積りに生かすよう配慮する", "keywords": ["暗算"], "refs": ["math-g4-A-2-a-u", "math-g4-A-3"]},
    {"id": "math-g4-handling-3", "code": "8250245300000000", "no": "(3)", "kind": "handling", "text": "第1学年から第4学年までに示す整数の計算の能力を定着させ、それを用いる能力を伸ばすことに配慮する", "refs": ["math-g4-A-3"]},
    {"id": "math-g4-handling-4", "code": "8250245400000000", "no": "(4)", "kind": "handling", "text": "除数と被除数に同じ数をかけても、同じ数で割っても、商は変わらないという性質などを取り扱う", "refs": ["math-g4-A-3-a-e"]},
    {"id": "math-g4-handling-5", "code": "8250245500000000", "no": "(5)", "kind": "handling", "text": "整数を整数で割って商が小数になる場合も含める", "refs": ["math-g4-A-4-a-e"]},
    {"id": "math-g4-handling-6", "code": "8250245600000000", "no": "(6)", "kind": "handling", "text": "交換法則、結合法則、分配法則を扱う", "keywords": ["交換法則", "結合法則", "分配法則"], "refs": ["math-g4-A-7-a-a"]},
    {"id": "math-g4-handling-7", "code": "8250245700000000", "no": "(7)", "kind": "handling", "text": "平行四辺形、ひし形、台形で平面を敷き詰めるなどの操作的な活動を重視するよう配慮する", "refs": ["math-g4-B-1"]},
    {"id": "math-g4-handling-8", "code": "8250245800000000", "no": "(8)", "kind": "handling", "text": "アール a、ヘクタール ha の単位についても触れる", "keywords": ["アール", "ヘクタール"], "refs": ["math-g4-B-4-a-a"]},
    {"id": "math-g4-handling-9", "code": "8250245900000000", "no": "(9)", "kind": "handling", "text": "資料を調べるときに、落ちや重なりがないようにすることを取り扱う", "refs": ["math-g4-D-1-a-a"]},
    {"id": "math-g4-handling-10", "code": "8250245A00000000", "no": "(10)", "kind": "handling", "text": "複数系列のグラフや組み合わせたグラフにも触れる", "refs": ["math-g4-D-1-a-i"]}
  ]
