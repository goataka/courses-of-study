{
  "id": "math-g2",
  "subject": "math",
  "grades": [2],
  "name": "第2学年",
  "code": "8250220000000000",
  "goals": [
    {"id": "math-g2-goal-1", "code": "8250222100000000", "no": "(1)", "kind": "goal", "category": "knowledge", "text": "数の概念の理解を深め、計算の意味と性質、基本的な図形の概念、量の概念、簡単な表とグラフなどを理解する。数量や図形の感覚を豊かにする。加法、減法、乗法の計算、図形の構成、長さやかさの測定、表やグラフへの表現などの技能を身に付ける"},
    {"id": "math-g2-goal-2", "code": "8250222200000000", "no": "(2)", "kind": "goal", "category": "thinking", "text": "数とその表現や数量の関係に着目し、必要に応じて具体物や図を用いて、数の表し方や計算の仕方を考察する力を養う。平面図形の特徴を構成要素に着目して捉え、身の回りの事象を図形の性質から考察する力を養う。身の回りのものの特徴を量に着目して捉え、量の単位を用いて的確に表現する力を養う。身の回りの事象をデータの特徴に着目して捉え、簡潔に表現したり考察したりする力を養う"},
    {"id": "math-g2-goal-3", "code": "8250222300000000", "no": "(3)", "kind": "goal", "category": "attitude", "text": "数量や図形に進んで関わり、数学的に表現し処理したことを振り返る。数理的な処理のよさに気付き、生活や学習に活用しようとする態度を養う"}
  ],
  "contents": [
    {"id": "math-g2-A", "code": "8250223100000000", "no": "A", "kind": "section", "title": "数と計算", "children": [
      {"id": "math-g2-A-1", "code": "8250223110000000", "no": "(1)", "kind": "section", "title": "数の構成と表し方", "children": [
        {"id": "math-g2-A-1-a-a", "code": "8250223111100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "同じ大きさの集まりにまとめて数えたり、分類して数えたりする"},
        {"id": "math-g2-A-1-a-i", "code": "8250223111200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "4位数までについて、十進位取り記数法による数の表し方と、数の大小や順序を理解する", "keywords": ["4位数", "十進位取り記数法"]},
        {"id": "math-g2-A-1-a-u", "code": "8250223111300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "数を十や百を単位としてみるなど、数の相対的な大きさを理解する", "keywords": ["相対的な大きさ"]},
        {"id": "math-g2-A-1-a-e", "code": "8250223111400000", "no": "ア(エ)", "kind": "item", "category": "knowledge", "text": "一つの数をほかの数の積としてみるなど、ほかの数と関係付けてみる", "keywords": ["積"]},
        {"id": "math-g2-A-1-a-o", "code": "8250223111500000", "no": "ア(オ)", "kind": "item", "category": "knowledge", "text": "簡単な事柄を分類整理し、数を用いて表す"},
        {"id": "math-g2-A-1-a-ka", "code": "8250223111600000", "no": "ア(カ)", "kind": "item", "category": "knowledge", "text": "1/2、1/3 など簡単な分数を知る", "keywords": ["簡単な分数"]},
        {"id": "math-g2-A-1-i-a", "code": "8250223112100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数のまとまりに着目し、大きな数の大きさの比べ方や数え方を考え、日常生活に生かす"}
      ]},
      {"id": "math-g2-A-2", "code": "8250223120000000", "no": "(2)", "kind": "section", "title": "加法及び減法", "children": [
        {"id": "math-g2-A-2-a-a", "code": "8250223121100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "2位数の加法とその逆の減法の計算が、1位数などの基本的な計算を基にしてできることを理解し、確実に計算できる。それらの筆算の仕方を理解する", "keywords": ["2位数の加法", "筆算"]},
        {"id": "math-g2-A-2-a-i", "code": "8250223121200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "簡単な場合について、3位数などの加法と減法の計算の仕方を知る"},
        {"id": "math-g2-A-2-a-u", "code": "8250223121300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "加法と減法に関して成り立つ性質を理解する"},
        {"id": "math-g2-A-2-a-e", "code": "8250223121400000", "no": "ア(エ)", "kind": "item", "category": "knowledge", "text": "加法と減法の相互関係を理解する", "keywords": ["相互関係"]},
        {"id": "math-g2-A-2-i-a", "code": "8250223122100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数量の関係に着目し、計算の仕方を考え、計算に関して成り立つ性質を見いだす。その性質を活用して、計算を工夫したり計算の確かめをしたりする"}
      ]},
      {"id": "math-g2-A-3", "code": "8250223130000000", "no": "(3)", "kind": "section", "title": "乗法", "children": [
        {"id": "math-g2-A-3-a-a", "code": "8250223131100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "乗法の意味を理解し、それが用いられる場合を知る", "keywords": ["乗法"]},
        {"id": "math-g2-A-3-a-i", "code": "8250223131200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "乗法が用いられる場面を式に表し、式を読み取る"},
        {"id": "math-g2-A-3-a-u", "code": "8250223131300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "乗法に関して成り立つ簡単な性質を理解する"},
        {"id": "math-g2-A-3-a-e", "code": "8250223131400000", "no": "ア(エ)", "kind": "item", "category": "knowledge", "text": "乗法九九を知り、1位数と1位数の乗法の計算が確実にできる", "keywords": ["乗法九九"]},
        {"id": "math-g2-A-3-a-o", "code": "8250223131500000", "no": "ア(オ)", "kind": "item", "category": "knowledge", "text": "簡単な場合について、2位数と1位数の乗法の計算の仕方を知る"},
        {"id": "math-g2-A-3-i-a", "code": "8250223132100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数量の関係に着目し、計算の意味や仕方を考え、計算に関して成り立つ性質を見いだす。その性質を活用して、計算を工夫したり計算の確かめをしたりする"},
        {"id": "math-g2-A-3-i-i", "code": "8250223132200000", "no": "イ(イ)", "kind": "item", "category": "thinking", "text": "数量の関係に着目し、計算を日常生活に生かす"}
      ]}
    ]},
    {"id": "math-g2-B", "code": "8250223200000000", "no": "B", "kind": "section", "title": "図形", "children": [
      {"id": "math-g2-B-1", "code": "8250223210000000", "no": "(1)", "kind": "section", "title": "図形", "children": [
        {"id": "math-g2-B-1-a-a", "code": "8250223211100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "三角形、四角形を知る", "keywords": ["三角形", "四角形"]},
        {"id": "math-g2-B-1-a-i", "code": "8250223211200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "正方形、長方形、直角三角形を知る", "keywords": ["正方形", "長方形", "直角三角形"]},
        {"id": "math-g2-B-1-a-u", "code": "8250223211300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "正方形や長方形の面で構成される箱の形をしたものを理解し、構成したり分解したりする", "keywords": ["箱の形"]},
        {"id": "math-g2-B-1-i-a", "code": "8250223212100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "図形を構成する要素に着目し、構成の仕方を考え、身の回りのものの形を図形として捉える"}
      ]}
    ]},
    {"id": "math-g2-C", "code": "8250223300000000", "no": "C", "kind": "section", "title": "測定", "children": [
      {"id": "math-g2-C-1", "code": "8250223310000000", "no": "(1)", "kind": "section", "title": "量の単位と測定", "children": [
        {"id": "math-g2-C-1-a-a", "code": "8250223311100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "長さの単位のミリメートル mm、センチメートル cm、メートル m と、かさの単位のミリリットル mL、デシリットル dL、リットル L を知り、測定の意味を理解する", "keywords": ["長さの単位", "かさの単位"]},
        {"id": "math-g2-C-1-a-i", "code": "8250223311200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "長さとかさについて、およその見当を付け、単位を適切に選択して測定する"},
        {"id": "math-g2-C-1-i-a", "code": "8250223312100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "身の回りのものの特徴に着目し、目的に応じた単位で量の大きさを的確に表現し、比べる"}
      ]},
      {"id": "math-g2-C-2", "code": "8250223320000000", "no": "(2)", "kind": "section", "title": "時刻と時間", "children": [
        {"id": "math-g2-C-2-a-a", "code": "8250223321100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "日、時、分を知り、それらの関係を理解する", "keywords": ["日、時、分"]},
        {"id": "math-g2-C-2-i-a", "code": "8250223322100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "時間の単位に着目し、時刻や時間を日常生活に生かす"}
      ]}
    ]},
    {"id": "math-g2-D", "code": "8250223400000000", "no": "D", "kind": "section", "title": "データの活用", "children": [
      {"id": "math-g2-D-1", "code": "8250223410000000", "no": "(1)", "kind": "section", "title": "データの分析", "children": [
        {"id": "math-g2-D-1-a-a", "code": "8250223411100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "身の回りにある数量を分類整理し、簡単な表やグラフを用いて表したり読み取ったりする", "keywords": ["表やグラフ"]},
        {"id": "math-g2-D-1-i-a", "code": "8250223412100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "データを整理する観点に着目し、身の回りの事象について表やグラフを用いて考察する"}
      ]}
    ]},
    {"id": "math-g2-activity", "code": "8250223500000000", "no": "", "kind": "section", "title": "数学的活動", "children": [
      {"id": "math-g2-activity-1-a", "code": "8250223511000000", "no": "(1)ア", "kind": "activity", "text": "身の回りの事象を観察したり具体物を操作したりして、数量や図形に進んで関わる活動"},
      {"id": "math-g2-activity-1-i", "code": "8250223512000000", "no": "(1)イ", "kind": "activity", "text": "日常の事象から見いだした算数の問題を、具体物、図、数、式などを用いて解決し、結果を確かめる活動"},
      {"id": "math-g2-activity-1-u", "code": "8250223513000000", "no": "(1)ウ", "kind": "activity", "text": "算数の学習場面から見いだした算数の問題を、具体物、図、数、式などを用いて解決し、結果を確かめる活動"},
      {"id": "math-g2-activity-1-e", "code": "8250223514000000", "no": "(1)エ", "kind": "activity", "text": "問題解決の過程や結果を、具体物、図、数、式などを用いて表現し伝え合う活動"}
    ]},
    {"id": "math-g2-terms", "code": "8250223600000000", "no": "", "kind": "section", "title": "用語・記号", "children": [
      {"id": "math-g2-terms-1", "code": "8250223601000000", "no": "", "kind": "term", "text": "直線"},
      {"id": "math-g2-terms-2", "code": "8250223602000000", "no": "", "kind": "term", "text": "直角"},
      {"id": "math-g2-terms-3", "code": "8250223603000000", "no": "", "kind": "term", "text": "頂点"},
      {"id": "math-g2-terms-4", "code": "8250223604000000", "no": "", "kind": "term", "text": "辺"},
      {"id": "math-g2-terms-5", "code": "8250223605000000", "no": "", "kind": "term", "text": "面"},
      {"id": "math-g2-terms-6", "code": "8250223606000000", "no": "", "kind": "term", "text": "単位"},
      {"id": "math-g2-terms-7", "code": "8250223607000000", "no": "", "kind": "term", "text": "×"},
      {"id": "math-g2-terms-8", "code": "8250223608000000", "no": "", "kind": "term", "text": "＞"},
      {"id": "math-g2-terms-9", "code": "8250223609000000", "no": "", "kind": "term", "text": "＜"}
    ]}
  ],
  "handling": [
    {"id": "math-g2-handling-1", "code": "8250225100000000", "no": "(1)", "kind": "handling", "text": "1万についても取り扱う", "keywords": ["1万"], "refs": ["math-g2-A-1"]},
    {"id": "math-g2-handling-2", "code": "8250225200000000", "no": "(2)", "kind": "handling", "text": "必要な場合には、かっこや□などを用いることができる。計算の結果の見積りについて配慮する", "keywords": ["見積り"], "refs": ["math-g2-A-2"]},
    {"id": "math-g2-handling-3", "code": "8250225300000000", "no": "(3)", "kind": "handling", "text": "交換法則や結合法則を取り扱う", "keywords": ["交換法則", "結合法則"], "refs": ["math-g2-A-2-a-u"]},
    {"id": "math-g2-handling-4", "code": "8250225400000000", "no": "(4)", "kind": "handling", "text": "主に、乗数が1ずつ増えるときの積の増え方や交換法則を取り扱う", "keywords": ["交換法則"], "refs": ["math-g2-A-3-a-u"]},
    {"id": "math-g2-handling-5", "code": "8250225500000000", "no": "(5)", "kind": "handling", "text": "正方形、長方形が身の回りで多く使われていることが分かるようにする。敷き詰めるなどの操作的な活動を通して、平面の広がりについての基礎となる経験を豊かにするよう配慮する", "refs": ["math-g2-B-1-a-i"]}
  ]
}
