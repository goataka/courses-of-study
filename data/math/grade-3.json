{
  "id": "math-g3",
  "subject": "math",
  "grades": [3],
  "name": "第3学年",
  "code": "8250230000000000",
  "goals": [
    {"id": "math-g3-goal-1", "code": "8250232100000000", "no": "(1)", "kind": "goal", "category": "knowledge", "text": "数の表し方、整数の計算の意味と性質、小数と分数の意味と表し方、基本的な図形の概念、量の概念、棒グラフなどを理解する。数量や図形の感覚を豊かにする。整数などの計算、図形の構成、長さや重さの測定、表やグラフへの表現などの技能を身に付ける"},
    {"id": "math-g3-goal-2", "code": "8250232200000000", "no": "(2)", "kind": "goal", "category": "thinking", "text": "数とその表現や数量の関係に着目し、必要に応じて具体物や図を用いて、数の表し方や計算の仕方を考察する力を養う。平面図形の特徴を構成要素に着目して捉え、身の回りの事象を図形の性質から考察する力を養う。身の回りのものの特徴を量に着目して捉え、量の単位を用いて的確に表現する力を養う。身の回りの事象をデータの特徴に着目して捉え、簡潔に表現したり適切に判断したりする力を養う"},
    {"id": "math-g3-goal-3", "code": "8250232300000000", "no": "(3)", "kind": "goal", "category": "attitude", "text": "数量や図形に進んで関わり、数学的に表現し処理したことを振り返る。数理的な処理のよさに気付き、生活や学習に活用しようとする態度を養う"}
  ],
  "contents": [
    {"id": "math-g3-A", "code": "8250233100000000", "no": "A", "kind": "section", "title": "数と計算", "children": [
      {"id": "math-g3-A-1", "code": "8250233110000000", "no": "(1)", "kind": "section", "title": "整数の表し方", "children": [
        {"id": "math-g3-A-1-a-a", "code": "8250233111100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "万の単位を知る", "keywords": ["万の単位"]},
        {"id": "math-g3-A-1-a-i", "code": "8250233111200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "10倍、100倍、1000倍、1/10 の大きさの数と、それらの表し方を知る"},
        {"id": "math-g3-A-1-a-u", "code": "8250233111300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "数の相対的な大きさの理解を深める", "keywords": ["相対的な大きさ"]},
        {"id": "math-g3-A-1-i-a", "code": "8250233112100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数のまとまりに着目し、大きな数の大きさの比べ方や表し方を考え、日常生活に生かす"}
      ]},
      {"id": "math-g3-A-2", "code": "8250233120000000", "no": "(2)", "kind": "section", "title": "加法及び減法", "children": [
        {"id": "math-g3-A-2-a-a", "code": "8250233121100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "3位数や4位数の加法と減法の計算が、2位数などの基本的な計算を基にしてできることを理解する。それらの筆算の仕方を理解する", "keywords": ["3位数や4位数の加法と減法", "筆算"]},
        {"id": "math-g3-A-2-a-i", "code": "8250233121200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "加法と減法の計算が確実にでき、適切に用いる"},
        {"id": "math-g3-A-2-i-a", "code": "8250233122100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数量の関係に着目し、計算の仕方を考え、計算に関して成り立つ性質を見いだす。その性質を活用して、計算を工夫したり計算の確かめをしたりする"}
      ]},
      {"id": "math-g3-A-3", "code": "8250233130000000", "no": "(3)", "kind": "section", "title": "乗法", "children": [
        {"id": "math-g3-A-3-a-a", "code": "8250233131100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "2位数や3位数に1位数や2位数をかける乗法の計算が、乗法九九などの基本的な計算を基にしてできることを理解する。その筆算の仕方を理解する", "keywords": ["乗法", "筆算"]},
        {"id": "math-g3-A-3-a-i", "code": "8250233131200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "乗法の計算が確実にでき、適切に用いる"},
        {"id": "math-g3-A-3-a-u", "code": "8250233131300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "乗法に関して成り立つ性質を理解する"},
        {"id": "math-g3-A-3-i-a", "code": "8250233132100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数量の関係に着目し、計算の仕方を考え、計算に関して成り立つ性質を見いだす。その性質を活用して、計算を工夫したり計算の確かめをしたりする"}
      ]},
      {"id": "math-g3-A-4", "code": "8250233140000000", "no": "(4)", "kind": "section", "title": "除法", "children": [
        {"id": "math-g3-A-4-a-a", "code": "8250233141100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "除法の意味を理解し、それが用いられる場合を知る。余りについて知る", "keywords": ["除法", "余り"]},
        {"id": "math-g3-A-4-a-i", "code": "8250233141200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "除法が用いられる場面を式に表し、式を読み取る"},
        {"id": "math-g3-A-4-a-u", "code": "8250233141300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "除法と、乗法や減法との関係を理解する"},
        {"id": "math-g3-A-4-a-e", "code": "8250233141400000", "no": "ア(エ)", "kind": "item", "category": "knowledge", "text": "除数と商が共に1位数である除法の計算が確実にできる", "keywords": ["除数と商が共に1位数"]},
        {"id": "math-g3-A-4-a-o", "code": "8250233141500000", "no": "ア(オ)", "kind": "item", "category": "knowledge", "text": "簡単な場合について、除数が1位数で商が2位数の除法の計算の仕方を知る"},
        {"id": "math-g3-A-4-i-a", "code": "8250233142100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数量の関係に着目し、計算の意味や仕方を考え、計算に関して成り立つ性質を見いだす。その性質を活用して、計算を工夫したり計算の確かめをしたりする"},
        {"id": "math-g3-A-4-i-i", "code": "8250233142200000", "no": "イ(イ)", "kind": "item", "category": "thinking", "text": "数量の関係に着目し、計算を日常生活に生かす"}
      ]},
      {"id": "math-g3-A-5", "code": "8250233150000000", "no": "(5)", "kind": "section", "title": "小数とその表し方", "children": [
        {"id": "math-g3-A-5-a-a", "code": "8250233151100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "端数部分の大きさを表すのに小数を用いることを知る。小数の表し方と 1/10 の位を知る", "keywords": ["小数", "1/10 の位"]},
        {"id": "math-g3-A-5-a-i", "code": "8250233151200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "1/10 の位までの小数の加法と減法の意味を理解し、それらの計算ができることを知る"},
        {"id": "math-g3-A-5-i-a", "code": "8250233152100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数のまとまりに着目し、小数でも数の大きさを比べたり計算したりできるかどうかを考え、小数を日常生活に生かす"}
      ]},
      {"id": "math-g3-A-6", "code": "8250233160000000", "no": "(6)", "kind": "section", "title": "分数とその表し方", "children": [
        {"id": "math-g3-A-6-a-a", "code": "8250233161100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "等分してできる部分の大きさや端数部分の大きさを表すのに分数を用いることを知る。分数の表し方を知る", "keywords": ["分数"]},
        {"id": "math-g3-A-6-a-i", "code": "8250233161200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "分数が単位分数の幾つ分かで表せることを知る", "keywords": ["単位分数"]},
        {"id": "math-g3-A-6-a-u", "code": "8250233161300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "簡単な場合について、分数の加法と減法の意味を理解し、それらの計算ができることを知る"},
        {"id": "math-g3-A-6-i-a", "code": "8250233162100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数のまとまりに着目し、分数でも数の大きさを比べたり計算したりできるかどうかを考え、分数を日常生活に生かす"}
      ]},
      {"id": "math-g3-A-7", "code": "8250233170000000", "no": "(7)", "kind": "section", "title": "数量の関係を表す式", "children": [
        {"id": "math-g3-A-7-a-a", "code": "8250233171100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "数量の関係を表す式を理解する。数量を□などを用いて表し、その関係を式に表したり、□などに数を当てはめて調べたりする"},
        {"id": "math-g3-A-7-i-a", "code": "8250233172100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "数量の関係に着目し、数量の関係を図や式を用いて簡潔に表したり、式と図を関連付けて式を読んだりする"}
      ]},
      {"id": "math-g3-A-8", "code": "8250233180000000", "no": "(8)", "kind": "section", "title": "そろばんを用いた数の表し方と計算", "children": [
        {"id": "math-g3-A-8-a-a", "code": "8250233181100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "そろばんによる数の表し方を知る", "keywords": ["そろばん"]},
        {"id": "math-g3-A-8-a-i", "code": "8250233181200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "簡単な加法と減法の計算の仕方を知り、計算する"},
        {"id": "math-g3-A-8-i-a", "code": "8250233182100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "そろばんの仕組みに着目し、大きな数や小数の計算の仕方を考える"}
      ]}
    ]},
    {"id": "math-g3-B", "code": "8250233200000000", "no": "B", "kind": "section", "title": "図形", "children": [
      {"id": "math-g3-B-1", "code": "8250233210000000", "no": "(1)", "kind": "section", "title": "図形", "children": [
        {"id": "math-g3-B-1-a-a", "code": "8250233211100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "二等辺三角形、正三角形などを知り、作図などを通してそれらの関係に次第に着目する", "keywords": ["二等辺三角形", "正三角形"]},
        {"id": "math-g3-B-1-a-i", "code": "8250233211200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "基本的な図形と関連して角を知る", "keywords": ["角"]},
        {"id": "math-g3-B-1-a-u", "code": "8250233211300000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "円について、中心、半径、直径を知る。円に関連して、球についても直径などを知る", "keywords": ["円", "球"]},
        {"id": "math-g3-B-1-i-a", "code": "8250233212100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "図形を構成する要素に着目し、構成の仕方を考え、図形の性質を見いだし、身の回りのものの形を図形として捉える"}
      ]}
    ]},
    {"id": "math-g3-C", "code": "8250233300000000", "no": "C", "kind": "section", "title": "測定", "children": [
      {"id": "math-g3-C-1", "code": "8250233310000000", "no": "(1)", "kind": "section", "title": "量の単位と測定", "children": [
        {"id": "math-g3-C-1-a-a", "code": "8250233311100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "長さの単位のキロメートル km と、重さの単位のグラム g、キログラム kg を知り、測定の意味を理解する", "keywords": ["長さの単位", "重さの単位"]},
        {"id": "math-g3-C-1-a-i", "code": "8250233311200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "長さや重さについて、適切な単位で表したり、およその見当を付け計器を適切に選んで測定したりする"},
        {"id": "math-g3-C-1-i-a", "code": "8250233312100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "身の回りのものの特徴に着目し、単位の関係を統合的に考察する"}
      ]},
      {"id": "math-g3-C-2", "code": "8250233320000000", "no": "(2)", "kind": "section", "title": "時刻と時間", "children": [
        {"id": "math-g3-C-2-a-a", "code": "8250233321100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "秒を知る", "keywords": ["秒"]},
        {"id": "math-g3-C-2-a-i", "code": "8250233321200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "日常生活に必要な時刻や時間を求める"},
        {"id": "math-g3-C-2-i-a", "code": "8250233322100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "時間の単位に着目し、時刻や時間の求め方を考察し、日常生活に生かす"}
      ]}
    ]},
    {"id": "math-g3-D", "code": "8250233400000000", "no": "D", "kind": "section", "title": "データの活用", "children": [
      {"id": "math-g3-D-1", "code": "8250233410000000", "no": "(1)", "kind": "section", "title": "データの分析", "children": [
        {"id": "math-g3-D-1-a-a", "code": "8250233411100000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "日時の観点や場所の観点などからデータを分類整理し、表に表したり読んだりする", "keywords": ["表"]},
        {"id": "math-g3-D-1-a-i", "code": "8250233411200000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "棒グラフの特徴と用い方を理解する", "keywords": ["棒グラフ"]},
        {"id": "math-g3-D-1-i-a", "code": "8250233412100000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "データを整理する観点に着目し、身の回りの事象について表やグラフを用いて考察し、見いだしたことを表現する"}
      ]}
    ]},
    {"id": "math-g3-activity", "code": "8250233500000000", "no": "", "kind": "section", "title": "数学的活動", "children": [
      {"id": "math-g3-activity-1-a", "code": "8250233511000000", "no": "(1)ア", "kind": "activity", "text": "身の回りの事象を観察したり具体物を操作したりして、数量や図形に進んで関わる活動"},
      {"id": "math-g3-activity-1-i", "code": "8250233512000000", "no": "(1)イ", "kind": "activity", "text": "日常の事象から見いだした算数の問題を、具体物、図、数、式などを用いて解決し、結果を確かめる活動"},
      {"id": "math-g3-activity-1-u", "code": "8250233513000000", "no": "(1)ウ", "kind": "activity", "text": "算数の学習場面から見いだした算数の問題を、具体物、図、数、式などを用いて解決し、結果を確かめる活動"},
      {"id": "math-g3-activity-1-e", "code": "8250233514000000", "no": "(1)エ", "kind": "activity", "text": "問題解決の過程や結果を、具体物、図、数、式などを用いて表現し伝え合う活動"}
    ]},
    {"id": "math-g3-terms", "code": "8250233600000000", "no": "", "kind": "section", "title": "用語・記号", "children": [
      {"id": "math-g3-terms-1", "code": "8250233601000000", "no": "", "kind": "term", "text": "等号"},
      {"id": "math-g3-terms-2", "code": "8250233602000000", "no": "", "kind": "term", "text": "不等号"},
      {"id": "math-g3-terms-3", "code": "8250233603000000", "no": "", "kind": "term", "text": "小数点"},
      {"id": "math-g3-terms-4", "code": "8250233604000000", "no": "", "kind": "term", "text": "1/10の位"},
      {"id": "math-g3-terms-5", "code": "8250233605000000", "no": "", "kind": "term", "text": "数直線"},
      {"id": "math-g3-terms-6", "code": "8250233606000000", "no": "", "kind": "term", "text": "分母"},
      {"id": "math-g3-terms-7", "code": "8250233607000000", "no": "", "kind": "term", "text": "分子"},
      {"id": "math-g3-terms-8", "code": "8250233608000000", "no": "", "kind": "term", "text": "÷"}
    ]}
  ],
  "handling": [
    {"id": "math-g3-handling-1", "code": "8250235100000000", "no": "(1)", "kind": "handling", "text": "1億についても取り扱う", "keywords": ["1億"], "refs": ["math-g3-A-1"]},
    {"id": "math-g3-handling-2", "code": "8250235200000000", "no": "(2)", "kind": "handling", "text": "簡単な計算は暗算でできるよう配慮する。計算の結果の見積りについても触れる", "keywords": ["暗算", "見積り"], "refs": ["math-g3-A-2", "math-g3-A-3"]},
    {"id": "math-g3-handling-3", "code": "8250235300000000", "no": "(3)", "kind": "handling", "text": "乗数または被乗数が 0 の場合の計算についても取り扱う", "keywords": ["0"], "refs": ["math-g3-A-3"]},
    {"id": "math-g3-handling-4", "code": "8250235400000000", "no": "(4)", "kind": "handling", "text": "交換法則、結合法則、分配法則を取り扱う", "keywords": ["交換法則", "結合法則", "分配法則"], "refs": ["math-g3-A-3-a-u"]},
    {"id": "math-g3-handling-5", "code": "8250235500000000", "no": "(5)", "kind": "handling", "text": "小数の 0.1 と分数の 1/10 などを、数直線を用いて関連付けて取り扱う", "refs": ["math-g3-A-5", "math-g3-A-6"]},
    {"id": "math-g3-handling-6", "code": "8250235600000000", "no": "(6)", "kind": "handling", "text": "基本的な図形について、定規、コンパスなどを用いて図形をかいたり確かめたりする活動を重視する。三角形や円などを基にして模様をかくなどの具体的な活動を通して、図形のもつ美しさに関心をもたせるよう配慮する", "refs": ["math-g3-B-1"]},
    {"id": "math-g3-handling-7", "code": "8250235700000000", "no": "(7)", "kind": "handling", "text": "重さの単位のトン t について触れる。接頭語のキロ k やミリ m についても触れる", "keywords": ["トン"], "refs": ["math-g3-C-1"]},
    {"id": "math-g3-handling-8", "code": "8250235800000000", "no": "(8)", "kind": "handling", "text": "最小目盛りが 2、5 または 20、50 などの棒グラフや、複数の棒グラフを組み合わせたグラフなどにも触れる", "refs": ["math-g3-D-1-a-i"]}
  ]
}
