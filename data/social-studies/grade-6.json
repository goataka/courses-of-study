        {"id": "social-studies-g6-handling-2-u-14", "code": "8220265231400000", "no": "", "kind": "term", "text": "源義経", "ruby": "源義経《みなもとのよしつね》"},
        {"id": "social-studies-g6-handling-2-u-15", "code": "8220265231500000", "no": "", "kind": "term", "text": "北条時宗", "ruby": "北条時宗《ほうじょうときむね》"},
