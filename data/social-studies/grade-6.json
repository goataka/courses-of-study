        {"id": "social-studies-g6-handling-2-u-21", "code": "8220265232100000", "no": "", "kind": "term", "text": "豊臣秀吉", "ruby": "豊臣秀吉《とよとみひでよし》"},
        {"id": "social-studies-g6-handling-2-u-22", "code": "8220265232200000", "no": "", "kind": "term", "text": "徳川家康", "ruby": "徳川家康《とくがわいえやす》"},
        {"id": "social-studies-g6-handling-2-u-23", "code": "8220265232300000", "no": "", "kind": "term", "text": "徳川家光", "ruby": "徳川家光《とくがわいえみつ》"},
        {"id": "social-studies-g6-handling-2-u-24", "code": "8220265232400000", "no": "", "kind": "term", "text": "近松門左衛門", "ruby": "近松門左衛門《ちかまつもんざえもん》"},
        {"id": "social-studies-g6-handling-2-u-25", "code": "8220265232500000", "no": "", "kind": "term", "text": "歌川広重", "ruby": "歌川広重《うたがわひろしげ》"},
