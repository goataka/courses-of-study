{
  "id": "social-studies-g4",
  "subject": "social-studies",
  "grades": [4],
  "name": "第4学年",
  "code": "8220240000000000",
  "goalsText": "社会的事象の見方・考え方を働かせ、学習の問題を追究し解決する活動を通して、次の資質と能力を育成する",
  "goals": [
    {"id": "social-studies-g4-goal-1", "code": "8220242100000000", "no": "(1)", "kind": "goal", "category": "knowledge", "text": "自分たちの都道府県の地理的環境の特色、地域の人々の健康と生活環境を支える働き、自然災害から地域の安全を守るための諸活動、地域の伝統と文化、地域の発展に尽くした先人の働きなどについて、人々の生活との関連を踏まえて理解する。調査活動、地図帳や各種の具体的資料を通して、必要な情報を調べまとめる技能を身に付ける"},
    {"id": "social-studies-g4-goal-2", "code": "8220242200000000", "no": "(2)", "kind": "goal", "category": "thinking", "text": "社会的事象の特色や相互の関連、意味を考える力を養う。社会に見られる課題を把握して、その解決に向けて社会への関わり方を選択し判断する力を養う。考えたことや選択し判断したことを表現する力を養う"},
    {"id": "social-studies-g4-goal-3", "code": "8220242300000000", "no": "(3)", "kind": "goal", "category": "attitude", "text": "社会的事象について、主体的に学習の問題を解決しようとする態度や、よりよい社会を考え学習したことを社会生活に生かそうとする態度を養う。思考や理解を通して、地域社会に対する誇りと愛情、地域社会の一員としての自覚を養う"}
  ],
  "contents": [
    {"id": "social-studies-g4-1", "code": "8220243100000000", "no": "(1)", "kind": "section", "title": "都道府県の様子", "text": "以下、都道府県を「県」と表す", "children": [
      {"id": "social-studies-g4-1-a-a", "code": "8220243111000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "自分たちの県の地理的環境の概要を理解する。47都道府県の名称と位置を理解する", "keywords": ["47都道府県の名称と位置"]},
      {"id": "social-studies-g4-1-a-i", "code": "8220243112000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "地図帳や各種の資料で調べ、白地図などにまとめる"},
      {"id": "social-studies-g4-1-i-a", "code": "8220243121000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "我が国における自分たちの県の位置、県全体の地形や主な産業の分布、交通網や主な都市の位置などに着目して、県の様子を捉え、地理的環境の特色を考え、表現する"}
    ]},
    {"id": "social-studies-g4-2", "code": "8220243200000000", "no": "(2)", "kind": "section", "title": "人々の健康や生活環境を支える事業", "children": [
      {"id": "social-studies-g4-2-a-a", "code": "8220243211000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "飲料水、電気、ガスを供給する事業は、安全で安定的に供給できるよう進められていることを理解する。地域の人々の健康な生活の維持と向上に役立っていることを理解する", "keywords": ["飲料水、電気、ガス"]},
      {"id": "social-studies-g4-2-a-i", "code": "8220243212000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "廃棄物を処理する事業は、衛生的な処理や資源の有効利用ができるよう進められていることを理解する。生活環境の維持と向上に役立っていることを理解する", "keywords": ["廃棄物を処理する事業"]},
      {"id": "social-studies-g4-2-a-u", "code": "8220243213000000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "見学や調査をしたり、地図などの資料で調べたりして、まとめる"},
      {"id": "social-studies-g4-2-i-a", "code": "8220243221000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "供給の仕組みや経路、県内外の人々の協力などに着目して、飲料水、電気、ガスの供給のための事業の様子を捉え、それらの事業が果たす役割を考え、表現する"},
      {"id": "social-studies-g4-2-i-i", "code": "8220243222000000", "no": "イ(イ)", "kind": "item", "category": "thinking", "text": "処理の仕組みや再利用、県内外の人々の協力などに着目して、廃棄物の処理のための事業の様子を捉え、その事業が果たす役割を考え、表現する"}
    ]},
    {"id": "social-studies-g4-3", "code": "8220243300000000", "no": "(3)", "kind": "section", "title": "自然災害から人々を守る活動", "children": [
      {"id": "social-studies-g4-3-a-a", "code": "8220243311000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "地域の関係機関や人々は、自然災害に対し、様々な協力をして対処してきたことを理解する。今後想定される災害に対し、様々な備えをしていることを理解する", "keywords": ["自然災害"]},
      {"id": "social-studies-g4-3-a-i", "code": "8220243312000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "聞き取り調査をしたり、地図や年表などの資料で調べたりして、まとめる"},
      {"id": "social-studies-g4-3-i-a", "code": "8220243321000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "過去に発生した地域の自然災害、関係機関の協力などに着目して、災害から人々を守る活動を捉え、その働きを考え、表現する"}
    ]},
    {"id": "social-studies-g4-4", "code": "8220243400000000", "no": "(4)", "kind": "section", "title": "県内の伝統や文化、先人の働き", "children": [
      {"id": "social-studies-g4-4-a-a", "code": "8220243411000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "県内の文化財や年中行事は、地域の人々が受け継いできたことを理解する。それらには地域の発展など、人々の様々な願いが込められていることを理解する", "keywords": ["文化財や年中行事"]},
      {"id": "social-studies-g4-4-a-i", "code": "8220243412000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "地域の発展に尽くした先人は、様々な苦心や努力により、当時の生活の向上に貢献したことを理解する", "keywords": ["先人"]},
      {"id": "social-studies-g4-4-a-u", "code": "8220243413000000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "見学や調査をしたり、地図などの資料で調べたりして、年表などにまとめる"},
      {"id": "social-studies-g4-4-i-a", "code": "8220243421000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "歴史的背景や現在に至る経過、保存や継承のための取組などに着目して、県内の文化財や年中行事の様子を捉え、人々の願いや努力を考え、表現する"},
      {"id": "social-studies-g4-4-i-i", "code": "8220243422000000", "no": "イ(イ)", "kind": "item", "category": "thinking", "text": "当時の世の中の課題や人々の願いなどに着目して、地域の発展に尽くした先人の具体的事例を捉え、先人の働きを考え、表現する"}
    ]},
    {"id": "social-studies-g4-5", "code": "8220243500000000", "no": "(5)", "kind": "section", "title": "県内の特色ある地域の様子", "children": [
      {"id": "social-studies-g4-5-a-a", "code": "8220243511000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "県内の特色ある地域では、人々が協力し、特色あるまちづくりや観光などの産業の発展に努めていることを理解する", "keywords": ["特色ある地域"]},
      {"id": "social-studies-g4-5-a-i", "code": "8220243512000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "地図帳や各種の資料で調べ、白地図などにまとめる"},
      {"id": "social-studies-g4-5-i-a", "code": "8220243521000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "特色ある地域の位置や自然環境、人々の活動や産業の歴史的背景、人々の協力関係などに着目して、地域の様子を捉え、それらの特色を考え、表現する"}
    ]}
  ],
  "handling": [
    {"id": "social-studies-g4-handling-1", "code": "8220245100000000", "no": "(1)", "kind": "handling", "refs": ["social-studies-g4-2"], "children": [
      {"id": "social-studies-g4-handling-1-a", "code": "8220245110000000", "no": "ア", "kind": "handling", "text": "現在に至るまでに仕組みが計画的に改善され、公衆衛生が向上してきたことに触れる", "keywords": ["公衆衛生"], "refs": ["social-studies-g4-2-a-a", "social-studies-g4-2-a-i"]},
      {"id": "social-studies-g4-handling-1-i", "code": "8220245120000000", "no": "イ", "kind": "handling", "text": "飲料水、電気、ガスの中から選択して取り上げる", "refs": ["social-studies-g4-2-a-a", "social-studies-g4-2-i-a"]},
      {"id": "social-studies-g4-handling-1-u", "code": "8220245130000000", "no": "ウ", "kind": "handling", "text": "ごみ、下水のいずれかを選択して取り上げる", "keywords": ["ごみ、下水"], "refs": ["social-studies-g4-2-a-i", "social-studies-g4-2-i-i"]},
      {"id": "social-studies-g4-handling-1-e", "code": "8220245140000000", "no": "エ", "kind": "handling", "text": "節水や節電など、自分たちにできることを考えたり、選択し判断したりできるよう配慮する", "keywords": ["節水や節電"], "refs": ["social-studies-g4-2-i-a"]},
      {"id": "social-studies-g4-handling-1-o", "code": "8220245150000000", "no": "オ", "kind": "handling", "text": "社会生活を営む上で大切な法やきまりについて扱う。ごみの減量や水を汚さない工夫など、自分たちにできることを考えたり、選択し判断したりできるよう配慮する", "keywords": ["法やきまり"], "refs": ["social-studies-g4-2-i-i"]}
    ]},
    {"id": "social-studies-g4-handling-2", "code": "8220245200000000", "no": "(2)", "kind": "handling", "refs": ["social-studies-g4-3"], "children": [
      {"id": "social-studies-g4-handling-2-a", "code": "8220245210000000", "no": "ア", "kind": "handling", "text": "地震災害、津波災害、風水害、火山災害、雪害などの中から、過去に県内で発生したものを選択して取り上げる", "keywords": ["地震災害、津波災害、風水害、火山災害、雪害"], "refs": ["social-studies-g4-3-a-a"]},
      {"id": "social-studies-g4-handling-2-i", "code": "8220245220000000", "no": "イ", "kind": "handling", "text": "「関係機関」については、県庁や市役所の働きなどを中心に取り上げる。防災情報の発信、避難体制の確保などの働き、自衛隊など国の機関との関わりを取り上げる", "keywords": ["県庁や市役所", "自衛隊"], "refs": ["social-studies-g4-3-a-a", "social-studies-g4-3-i-a"]},
      {"id": "social-studies-g4-handling-2-u", "code": "8220245230000000", "no": "ウ", "kind": "handling", "text": "地域で起こり得る災害を想定し、日頃から必要な備えをするなど、自分たちにできることなどを考えたり、選択し判断したりできるよう配慮する", "refs": ["social-studies-g4-3-i-a"]}
    ]},
    {"id": "social-studies-g4-handling-3", "code": "8220245300000000", "no": "(3)", "kind": "handling", "refs": ["social-studies-g4-4"], "children": [
      {"id": "social-studies-g4-handling-3-a", "code": "8220245310000000", "no": "ア", "kind": "handling", "text": "アの(ア)については、県内の主な文化財や年中行事が大まかに分かるようにする。イの(ア)については、それらの中から具体的事例を取り上げる", "refs": ["social-studies-g4-4-a-a", "social-studies-g4-4-i-a"]},
      {"id": "social-studies-g4-handling-3-i", "code": "8220245320000000", "no": "イ", "kind": "handling", "text": "開発、教育、医療、文化、産業などの地域の発展に尽くした先人の中から選択して取り上げる", "keywords": ["開発、教育、医療、文化、産業"], "refs": ["social-studies-g4-4-a-i", "social-studies-g4-4-i-i"]},
      {"id": "social-studies-g4-handling-3-u", "code": "8220245330000000", "no": "ウ", "kind": "handling", "text": "地域の伝統や文化の保存や継承に関わって、自分たちにできることなどを考えたり、選択し判断したりできるよう配慮する", "refs": ["social-studies-g4-4-i-a"]}
    ]},
    {"id": "social-studies-g4-handling-4", "code": "8220245400000000", "no": "(4)", "kind": "handling", "refs": ["social-studies-g4-5"], "children": [
      {"id": "social-studies-g4-handling-4-a", "code": "8220245410000000", "no": "ア", "kind": "handling", "text": "県内の特色ある地域が大まかに分かるようにする。伝統的な技術を生かした地場産業が盛んな地域、国際交流に取り組んでいる地域、地域の資源を保護し活用している地域を取り上げる。地域の資源を保護し活用している地域については、自然環境、伝統的な文化のいずれかを選択して取り上げる", "keywords": ["伝統的な技術を生かした地場産業が盛んな地域", "国際交流に取り組んでいる地域", "地域の資源を保護し活用している地域"], "refs": ["social-studies-g4-5"]},
      {"id": "social-studies-g4-handling-4-i", "code": "8220245420000000", "no": "イ", "kind": "handling", "text": "国際交流に取り組んでいる地域を取り上げる際には、我が国や外国には国旗があることを理解し、それを尊重する態度を養うよう配慮する", "keywords": ["国旗"], "refs": ["social-studies-g4-5"]}
    ]}
  ]
}
