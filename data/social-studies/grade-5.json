{
  "id": "social-studies-g5",
  "subject": "social-studies",
  "grades": [5],
  "name": "第5学年",
  "code": "8220250000000000",
  "goalsText": "社会的事象の見方・考え方を働かせ、学習の問題を追究し解決する活動を通して、次の資質と能力を育成する",
  "goals": [
    {"id": "social-studies-g5-goal-1", "code": "8220252100000000", "no": "(1)", "kind": "goal", "category": "knowledge", "text": "我が国の国土の地理的環境の特色や産業の現状、社会の情報化と産業の関わりについて、国民生活との関連を踏まえて理解する。地図帳や地球儀、統計などの各種の基礎的資料を通して、情報を適切に調べまとめる技能を身に付ける"},
    {"id": "social-studies-g5-goal-2", "code": "8220252200000000", "no": "(2)", "kind": "goal", "category": "thinking", "text": "社会的事象の特色や相互の関連、意味を多角的に考える力を養う。社会に見られる課題を把握して、その解決に向けて社会への関わり方を選択し判断する力を養う。考えたことや選択し判断したことを説明したり、それらを基に議論したりする力を養う"},
    {"id": "social-studies-g5-goal-3", "code": "8220252300000000", "no": "(3)", "kind": "goal", "category": "attitude", "text": "社会的事象について、主体的に学習の問題を解決しようとする態度や、よりよい社会を考え学習したことを社会生活に生かそうとする態度を養う。多角的な思考や理解を通して、我が国の国土に対する愛情、我が国の産業の発展を願い我が国の将来を担う国民としての自覚を養う"}
  ],
  "contents": [
    {"id": "social-studies-g5-1", "code": "8220253100000000", "no": "(1)", "kind": "section", "title": "我が国の国土の様子と国民生活", "children": [
      {"id": "social-studies-g5-1-a-a", "code": "8220253111000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "世界における我が国の国土の位置、国土の構成、領土の範囲などを大まかに理解する", "keywords": ["国土の位置", "領土の範囲"]},
      {"id": "social-studies-g5-1-a-i", "code": "8220253112000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "我が国の国土の地形や気候の概要を理解する。人々は自然環境に適応して生活していることを理解する", "keywords": ["地形や気候"]},
      {"id": "social-studies-g5-1-a-u", "code": "8220253113000000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "地図帳や地球儀、各種の資料で調べ、まとめる"},
      {"id": "social-studies-g5-1-i-a", "code": "8220253121000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "世界の大陸と主な海洋、主な国の位置、海洋に囲まれ多数の島からなる国土の構成などに着目して、我が国の国土の様子を捉え、その特色を考え、表現する"},
      {"id": "social-studies-g5-1-i-i", "code": "8220253122000000", "no": "イ(イ)", "kind": "item", "category": "thinking", "text": "地形や気候などに着目して、国土の自然などの様子や、自然条件から見て特色ある地域の人々の生活を捉え、国土の自然環境の特色やそれらと国民生活との関連を考え、表現する"}
    ]},
    {"id": "social-studies-g5-2", "code": "8220253200000000", "no": "(2)", "kind": "section", "title": "我が国の農業や水産業における食料生産", "children": [
      {"id": "social-studies-g5-2-a-a", "code": "8220253211000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "我が国の食料生産は、自然条件を生かして営まれていることを理解する。国民の食料を確保する重要な役割を果たしていることを理解する", "keywords": ["食料生産"]},
      {"id": "social-studies-g5-2-a-i", "code": "8220253212000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "食料生産に関わる人々は、生産性や品質を高めるよう努力したり、輸送方法や販売方法を工夫したりして、良質な食料を消費地に届けるなど、食料生産を支えていることを理解する"},
      {"id": "social-studies-g5-2-a-u", "code": "8220253213000000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "地図帳や地球儀、各種の資料で調べ、まとめる"},
      {"id": "social-studies-g5-2-i-a", "code": "8220253221000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "生産物の種類や分布、生産量の変化、輸入など外国との関わりなどに着目して、食料生産の概要を捉え、食料生産が国民生活に果たす役割を考え、表現する"},
      {"id": "social-studies-g5-2-i-i", "code": "8220253222000000", "no": "イ(イ)", "kind": "item", "category": "thinking", "text": "生産の工程、人々の協力関係、技術の向上、輸送、価格や費用などに着目して、食料生産に関わる人々の工夫や努力を捉え、その働きを考え、表現する"}
    ]},
    {"id": "social-studies-g5-3", "code": "8220253300000000", "no": "(3)", "kind": "section", "title": "我が国の工業生産", "children": [
      {"id": "social-studies-g5-3-a-a", "code": "8220253311000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "我が国では様々な工業生産が行われていることを理解する。国土には工業の盛んな地域が広がっていることを理解する。工業製品は国民生活の向上に重要な役割を果たしていることを理解する", "keywords": ["工業生産"]},
      {"id": "social-studies-g5-3-a-i", "code": "8220253312000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "工業生産に関わる人々は、消費者の需要や社会の変化に対応し、優れた製品を生産するよう様々な工夫や努力をして、工業生産を支えていることを理解する"},
      {"id": "social-studies-g5-3-a-u", "code": "8220253313000000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "貿易や運輸は、原材料の確保や製品の販売などにおいて、工業生産を支える重要な役割を果たしていることを理解する", "keywords": ["貿易や運輸"]},
      {"id": "social-studies-g5-3-a-e", "code": "8220253314000000", "no": "ア(エ)", "kind": "item", "category": "knowledge", "text": "地図帳や地球儀、各種の資料で調べ、まとめる"},
      {"id": "social-studies-g5-3-i-a", "code": "8220253321000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "工業の種類、工業の盛んな地域の分布、工業製品の改良などに着目して、工業生産の概要を捉え、工業生産が国民生活に果たす役割を考え、表現する"},
      {"id": "social-studies-g5-3-i-i", "code": "8220253322000000", "no": "イ(イ)", "kind": "item", "category": "thinking", "text": "製造の工程、工場相互の協力関係、優れた技術などに着目して、工業生産に関わる人々の工夫や努力を捉え、その働きを考え、表現する"},
      {"id": "social-studies-g5-3-i-u", "code": "8220253323000000", "no": "イ(ウ)", "kind": "item", "category": "thinking", "text": "交通網の広がり、外国との関わりなどに着目して、貿易や運輸の様子を捉え、それらの役割を考え、表現する"}
    ]},
    {"id": "social-studies-g5-4", "code": "8220253400000000", "no": "(4)", "kind": "section", "title": "我が国の産業と情報との関わり", "children": [
      {"id": "social-studies-g5-4-a-a", "code": "8220253411000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "放送、新聞などの産業は、国民生活に大きな影響を及ぼしていることを理解する", "keywords": ["放送、新聞"]},
      {"id": "social-studies-g5-4-a-i", "code": "8220253412000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "大量の情報や情報通信技術の活用は、様々な産業を発展させ、国民生活を向上させていることを理解する", "keywords": ["情報通信技術"]},
      {"id": "social-studies-g5-4-a-u", "code": "8220253413000000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "聞き取り調査をしたり、映像や新聞などの各種資料で調べたりして、まとめる"},
      {"id": "social-studies-g5-4-i-a", "code": "8220253421000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "情報を集め発信するまでの工夫や努力などに着目して、放送、新聞などの産業の様子を捉え、それらの産業が国民生活に果たす役割を考え、表現する"},
      {"id": "social-studies-g5-4-i-i", "code": "8220253422000000", "no": "イ(イ)", "kind": "item", "category": "thinking", "text": "情報の種類、情報の活用の仕方などに着目して、産業における情報活用の現状を捉え、情報を生かして発展する産業が国民生活に果たす役割を考え、表現する"}
    ]},
    {"id": "social-studies-g5-5", "code": "8220253500000000", "no": "(5)", "kind": "section", "title": "我が国の国土の自然環境と国民生活との関連", "children": [
      {"id": "social-studies-g5-5-a-a", "code": "8220253511000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "自然災害は国土の自然条件などと関連して発生していることを理解する。自然災害から国土を保全し国民生活を守るために、国や県などが様々な対策や事業を進めていることを理解する", "keywords": ["自然災害"]},
      {"id": "social-studies-g5-5-a-i", "code": "8220253512000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "森林は、その育成や保護に従事している人々の様々な工夫と努力により、国土の保全など重要な役割を果たしていることを理解する", "keywords": ["森林"]},
      {"id": "social-studies-g5-5-a-u", "code": "8220253513000000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "関係機関や地域の人々の様々な努力により、公害の防止や生活環境の改善が図られてきたことを理解する。公害から国土の環境や国民の健康な生活を守ることの大切さを理解する", "keywords": ["公害"]},
      {"id": "social-studies-g5-5-a-e", "code": "8220253514000000", "no": "ア(エ)", "kind": "item", "category": "knowledge", "text": "地図帳や各種の資料で調べ、まとめる"},
      {"id": "social-studies-g5-5-i-a", "code": "8220253521000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "災害の種類や発生の位置や時期、防災対策などに着目して、国土の自然災害の状況を捉え、自然条件との関連を考え、表現する"},
      {"id": "social-studies-g5-5-i-i", "code": "8220253522000000", "no": "イ(イ)", "kind": "item", "category": "thinking", "text": "森林資源の分布や働きなどに着目して、国土の環境を捉え、森林資源が果たす役割を考え、表現する"},
      {"id": "social-studies-g5-5-i-u", "code": "8220253523000000", "no": "イ(ウ)", "kind": "item", "category": "thinking", "text": "公害の発生時期や経過、人々の協力や努力などに着目して、公害防止の取組を捉え、その働きを考え、表現する"}
    ]}
  ],
  "handling": [
    {"id": "social-studies-g5-handling-1", "code": "8220255100000000", "no": "(1)", "kind": "handling", "refs": ["social-studies-g5-1"], "children": [
      {"id": "social-studies-g5-handling-1-a", "code": "8220255110000000", "no": "ア", "kind": "handling", "text": "「領土の範囲」については、竹島や北方領土、尖閣諸島が我が国の固有の領土であることに触れる", "keywords": ["竹島や北方領土、尖閣諸島"], "refs": ["social-studies-g5-1-a-a"]},
      {"id": "social-studies-g5-handling-1-i", "code": "8220255120000000", "no": "イ", "kind": "handling", "text": "地図帳や地球儀を用いて、方位、緯度や経度などによる位置の表し方を取り扱う", "keywords": ["方位、緯度や経度"], "refs": ["social-studies-g5-1-a-u"]},
      {"id": "social-studies-g5-handling-1-u", "code": "8220255130000000", "no": "ウ", "kind": "handling", "text": "「主な国」については、名称についても扱い、近隣の諸国を含めて取り上げる。その際、我が国や諸外国には国旗があることを理解し、それを尊重する態度を養うよう配慮する", "keywords": ["国旗"], "refs": ["social-studies-g5-1-i-a"]},
      {"id": "social-studies-g5-handling-1-e", "code": "8220255140000000", "no": "エ", "kind": "handling", "text": "「自然条件から見て特色ある地域」については、地形条件や気候条件から見て特色ある地域を取り上げる", "refs": ["social-studies-g5-1-i-i"]}
    ]},
    {"id": "social-studies-g5-handling-2", "code": "8220255200000000", "no": "(2)", "kind": "handling", "refs": ["social-studies-g5-2"], "children": [
      {"id": "social-studies-g5-handling-2-a", "code": "8220255210000000", "no": "ア", "kind": "handling", "text": "食料生産の盛んな地域の具体的事例を通して調べる。稲作のほか、野菜、果物、畜産物、水産物などの中から一つを取り上げる", "keywords": ["稲作", "野菜、果物、畜産物、水産物"], "refs": ["social-studies-g5-2-a-i", "social-studies-g5-2-i-i"]},
      {"id": "social-studies-g5-handling-2-i", "code": "8220255220000000", "no": "イ", "kind": "handling", "text": "消費者や生産者の立場などから多角的に考えて、これからの農業などの発展について、自分の考えをまとめることができるよう配慮する", "refs": ["social-studies-g5-2-i-a", "social-studies-g5-2-i-i"]}
    ]},
    {"id": "social-studies-g5-handling-3", "code": "8220255300000000", "no": "(3)", "kind": "handling", "refs": ["social-studies-g5-3"], "children": [
      {"id": "social-studies-g5-handling-3-a", "code": "8220255310000000", "no": "ア", "kind": "handling", "text": "工業の盛んな地域の具体的事例を通して調べる。金属工業、機械工業、化学工業、食料品工業などの中から一つを取り上げる", "keywords": ["金属工業、機械工業、化学工業、食料品工業"], "refs": ["social-studies-g5-3-a-i", "social-studies-g5-3-i-i"]},
      {"id": "social-studies-g5-handling-3-i", "code": "8220255320000000", "no": "イ", "kind": "handling", "text": "消費者や生産者の立場などから多角的に考えて、これからの工業の発展について、自分の考えをまとめることができるよう配慮する", "refs": ["social-studies-g5-3-i-a", "social-studies-g5-3-i-i"]}
    ]},
    {"id": "social-studies-g5-handling-4", "code": "8220255400000000", "no": "(4)", "kind": "handling", "refs": ["social-studies-g5-4"], "children": [
      {"id": "social-studies-g5-handling-4-a", "code": "8220255410000000", "no": "ア", "kind": "handling", "text": "「放送、新聞などの産業」については、それらの中から選択して取り上げる。その際、情報を有効に活用することについて、情報の送り手と受け手の立場から多角的に考え、受け手として正しく判断することや、送り手として責任をもつことが大切であることに気付くようにする", "refs": ["social-studies-g5-4-a-a"]},
      {"id": "social-studies-g5-handling-4-i", "code": "8220255420000000", "no": "イ", "kind": "handling", "text": "情報や情報技術を活用して発展している販売、運輸、観光、医療、福祉などに関わる産業の中から選択して取り上げる。その際、産業と国民の立場から多角的に考えて、情報化の進展に伴う産業の発展や国民生活の向上について、自分の考えをまとめることができるよう配慮する", "keywords": ["販売、運輸、観光、医療、福祉"], "refs": ["social-studies-g5-4-a-i", "social-studies-g5-4-i-i"]}
    ]},
    {"id": "social-studies-g5-handling-5", "code": "8220255500000000", "no": "(5)", "kind": "handling", "refs": ["social-studies-g5-5"], "children": [
      {"id": "social-studies-g5-handling-5-a", "code": "8220255510000000", "no": "ア", "kind": "handling", "text": "地震災害、津波災害、風水害、火山災害、雪害などを取り上げる", "keywords": ["地震災害、津波災害、風水害、火山災害、雪害"], "refs": ["social-studies-g5-5-a-a"]},
      {"id": "social-studies-g5-handling-5-i", "code": "8220255520000000", "no": "イ", "kind": "handling", "text": "大気の汚染、水質の汚濁などの中から具体的事例を選択して取り上げる", "keywords": ["大気の汚染、水質の汚濁"], "refs": ["social-studies-g5-5-a-u", "social-studies-g5-5-i-u"]},
      {"id": "social-studies-g5-handling-5-u", "code": "8220255530000000", "no": "ウ", "kind": "handling", "text": "国土の環境保全について、自分たちにできることなどを考えたり、選択し判断したりできるよう配慮する", "refs": ["social-studies-g5-5-i-i", "social-studies-g5-5-i-u"]}
    ]}
  ]
}
