{
  "id": "social-studies-g3",
  "subject": "social-studies",
  "grades": [3],
  "name": "第3学年",
  "code": "8220230000000000",
  "goalsText": "社会的事象の見方・考え方を働かせ、学習の問題を追究し解決する活動を通して、次の資質と能力を育成する",
  "goals": [
    {"id": "social-studies-g3-goal-1", "code": "8220232100000000", "no": "(1)", "kind": "goal", "category": "knowledge", "text": "身近な地域や市区町村の地理的環境、地域の安全を守るための諸活動、地域の産業と消費生活の様子、地域の様子の移り変わりについて、人々の生活との関連を踏まえて理解する。調査活動、地図帳や各種の具体的資料を通して、必要な情報を調べまとめる技能を身に付ける"},
    {"id": "social-studies-g3-goal-2", "code": "8220232200000000", "no": "(2)", "kind": "goal", "category": "thinking", "text": "社会的事象の特色や相互の関連、意味を考える力を養う。社会に見られる課題を把握して、その解決に向けて社会への関わり方を選択し判断する力を養う。考えたことや選択し判断したことを表現する力を養う"},
    {"id": "social-studies-g3-goal-3", "code": "8220232300000000", "no": "(3)", "kind": "goal", "category": "attitude", "text": "社会的事象について、主体的に学習の問題を解決しようとする態度や、よりよい社会を考え学習したことを社会生活に生かそうとする態度を養う。思考や理解を通して、地域社会に対する誇りと愛情、地域社会の一員としての自覚を養う"}
  ],
  "contents": [
    {"id": "social-studies-g3-1", "code": "8220233100000000", "no": "(1)", "kind": "section", "title": "身近な地域や市区町村の様子", "text": "以下、市区町村を「市」と表す", "children": [
      {"id": "social-studies-g3-1-a-a", "code": "8220233111000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "身近な地域や自分たちの市の様子を大まかに理解する", "keywords": ["市の様子"]},
      {"id": "social-studies-g3-1-a-i", "code": "8220233112000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "観察や調査をしたり、地図などの資料で調べたりして、白地図などにまとめる", "keywords": ["白地図"]},
      {"id": "social-studies-g3-1-i-a", "code": "8220233121000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "都道府県内における市の位置、市の地形や土地利用、交通の広がり、市役所など主な公共施設の場所と働き、古くから残る建造物の分布などに着目して、身近な地域や市の様子を捉え、場所による違いを考え、表現する"}
    ]},
    {"id": "social-studies-g3-2", "code": "8220233200000000", "no": "(2)", "kind": "section", "title": "地域に見られる生産や販売の仕事", "children": [
      {"id": "social-studies-g3-2-a-a", "code": "8220233211000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "生産の仕事は、地域の人々の生活と密接な関わりをもって行われていることを理解する", "keywords": ["生産の仕事"]},
      {"id": "social-studies-g3-2-a-i", "code": "8220233212000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "販売の仕事は、消費者の多様な願いを踏まえ、売り上げを高めるよう工夫して行われていることを理解する", "keywords": ["販売の仕事"]},
      {"id": "social-studies-g3-2-a-u", "code": "8220233213000000", "no": "ア(ウ)", "kind": "item", "category": "knowledge", "text": "見学や調査をしたり、地図などの資料で調べたりして、白地図などにまとめる"},
      {"id": "social-studies-g3-2-i-a", "code": "8220233221000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "仕事の種類や産地の分布、仕事の工程などに着目して、生産に携わっている人々の仕事の様子を捉え、地域の人々の生活との関連を考え、表現する"},
      {"id": "social-studies-g3-2-i-i", "code": "8220233222000000", "no": "イ(イ)", "kind": "item", "category": "thinking", "text": "消費者の願い、販売の仕方、他地域や外国との関わりなどに着目して、販売に携わっている人々の仕事の様子を捉え、それらの仕事に見られる工夫を考え、表現する"}
    ]},
    {"id": "social-studies-g3-3", "code": "8220233300000000", "no": "(3)", "kind": "section", "title": "地域の安全を守る働き", "children": [
      {"id": "social-studies-g3-3-a-a", "code": "8220233311000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "消防署や警察署などの関係機関は、地域の安全を守るために、相互に連携して緊急時に対処する体制をとっていることを理解する。関係機関が地域の人々と協力して、火災や事故などの防止に努めていることを理解する", "keywords": ["消防署や警察署"]},
      {"id": "social-studies-g3-3-a-i", "code": "8220233312000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "見学や調査をしたり、地図などの資料で調べたりして、まとめる"},
      {"id": "social-studies-g3-3-i-a", "code": "8220233321000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "施設や設備などの配置、緊急時への備えや対応などに着目して、関係機関や地域の人々の諸活動を捉え、相互の関連や従事する人々の働きを考え、表現する"}
    ]},
    {"id": "social-studies-g3-4", "code": "8220233400000000", "no": "(4)", "kind": "section", "title": "市の様子の移り変わり", "children": [
      {"id": "social-studies-g3-4-a-a", "code": "8220233411000000", "no": "ア(ア)", "kind": "item", "category": "knowledge", "text": "市や人々の生活の様子は、時間の経過に伴い、移り変わってきたことを理解する", "keywords": ["移り変わってきた"]},
      {"id": "social-studies-g3-4-a-i", "code": "8220233412000000", "no": "ア(イ)", "kind": "item", "category": "knowledge", "text": "聞き取り調査をしたり、地図などの資料で調べたりして、年表などにまとめる", "keywords": ["年表"]},
      {"id": "social-studies-g3-4-i-a", "code": "8220233421000000", "no": "イ(ア)", "kind": "item", "category": "thinking", "text": "交通や公共施設、土地利用や人口、生活の道具などの時期による違いに着目して、市や人々の生活の様子を捉え、それらの変化を考え、表現する"}
    ]}
  ],
  "handling": [
    {"id": "social-studies-g3-handling-1", "code": "8220235100000000", "no": "(1)", "kind": "handling", "refs": ["social-studies-g3-1"], "children": [
      {"id": "social-studies-g3-handling-1-a", "code": "8220235110000000", "no": "ア", "kind": "handling", "text": "学年の導入で扱う。「自分たちの市」に重点を置くよう配慮する", "refs": ["social-studies-g3-1-a-a"]},
      {"id": "social-studies-g3-handling-1-i", "code": "8220235120000000", "no": "イ", "kind": "handling", "text": "「白地図などにまとめる」際に、教科用図書の地図である地図帳を参照し、方位や主な地図記号について扱う", "keywords": ["地図帳", "方位", "地図記号"], "refs": ["social-studies-g3-1-a-i"]}
    ]},
    {"id": "social-studies-g3-handling-2", "code": "8220235200000000", "no": "(2)", "kind": "handling", "refs": ["social-studies-g3-2"], "children": [
      {"id": "social-studies-g3-handling-2-a", "code": "8220235210000000", "no": "ア", "kind": "handling", "text": "事例として、農家、工場などの中から選択して取り上げる", "keywords": ["農家、工場"], "refs": ["social-studies-g3-2-a-a", "social-studies-g3-2-i-a"]},
      {"id": "social-studies-g3-handling-2-i", "code": "8220235220000000", "no": "イ", "kind": "handling", "text": "商店を取り上げる。「他地域や外国との関わり」を扱う際には、地図帳などを使用して、都道府県や国の名称と位置などを調べるようにする", "keywords": ["商店"], "refs": ["social-studies-g3-2-a-i", "social-studies-g3-2-i-i"]},
      {"id": "social-studies-g3-handling-2-u", "code": "8220235230000000", "no": "ウ", "kind": "handling", "text": "我が国や外国には国旗があることを理解し、それを尊重する態度を養うよう配慮する", "keywords": ["国旗"], "refs": ["social-studies-g3-2-i-i"]}
    ]},
    {"id": "social-studies-g3-handling-3", "code": "8220235300000000", "no": "(3)", "kind": "handling", "refs": ["social-studies-g3-3"], "children": [
      {"id": "social-studies-g3-handling-3-a", "code": "8220235310000000", "no": "ア", "kind": "handling", "text": "「緊急時に対処する体制をとっていること」と「防止に努めていること」については、火災と事故はいずれも取り上げる。その際、どちらかに重点を置くなど効果的な指導を工夫する", "keywords": ["火災と事故"], "refs": ["social-studies-g3-3-a-a"]},
      {"id": "social-studies-g3-handling-3-i", "code": "8220235320000000", "no": "イ", "kind": "handling", "text": "社会生活を営む上で大切な法やきまりについて扱う。地域や自分自身の安全を守るために自分たちにできることなどを考えたり、選択し判断したりできるよう配慮する", "keywords": ["法やきまり"], "refs": ["social-studies-g3-3-i-a"]}
    ]},
    {"id": "social-studies-g3-handling-4", "code": "8220235400000000", "no": "(4)", "kind": "handling", "refs": ["social-studies-g3-4"], "children": [
      {"id": "social-studies-g3-handling-4-a", "code": "8220235410000000", "no": "ア", "kind": "handling", "text": "「年表などにまとめる」際には、時期の区分について、昭和、平成など元号を用いた言い表し方などがあることを取り上げる", "keywords": ["元号"], "refs": ["social-studies-g3-4-a-i"]},
      {"id": "social-studies-g3-handling-4-i", "code": "8220235420000000", "no": "イ", "kind": "handling", "text": "「公共施設」については、市が公共施設の整備を進めてきたことを取り上げる。その際、租税の役割に触れる", "keywords": ["租税の役割"], "refs": ["social-studies-g3-4-i-a"]},
      {"id": "social-studies-g3-handling-4-u", "code": "8220235430000000", "no": "ウ", "kind": "handling", "text": "「人口」を取り上げる際には、少子高齢化、国際化などに触れ、これからの市の発展について考えることができるよう配慮する", "keywords": ["少子高齢化、国際化"], "refs": ["social-studies-g3-4-i-a"]}
    ]}
  ]
}
