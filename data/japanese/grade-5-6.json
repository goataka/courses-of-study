{
  "id": "japanese-g56",
  "subject": "japanese",
  "grades": [5, 6],
  "name": "第5学年及び第6学年",
  "code": "82102D0000000000",
  "goals": [
    {"id": "japanese-g56-goal-1", "code": "82102D2100000000", "no": "(1)", "kind": "goal", "category": "knowledge", "text": "日常生活に必要な国語の知識や技能を身に付ける。我が国の言語文化に親しんだり理解したりできるようにする"},
    {"id": "japanese-g56-goal-2", "code": "82102D2200000000", "no": "(2)", "kind": "goal", "category": "thinking", "text": "筋道立てて考える力や、豊かに感じたり想像したりする力を養う。日常生活における人との関わりの中で伝え合う力を高め、自分の思いや考えを広げることができるようにする", "keywords": ["筋道立てて考える力"]},
    {"id": "japanese-g56-goal-3", "code": "82102D2300000000", "no": "(3)", "kind": "goal", "category": "attitude", "text": "言葉がもつよさを認識し、進んで読書をする。国語の大切さを自覚して、思いや考えを伝え合おうとする態度を養う"}
  ],
  "contents": [
    {"id": "japanese-g56-K", "code": "82102D3100000000", "no": "", "kind": "section", "title": "知識及び技能", "children": [
      {"id": "japanese-g56-K-1", "code": "82102D3110000000", "no": "(1)", "kind": "section", "title": "言葉の特徴や使い方に関する事項", "children": [
        {"id": "japanese-g56-K-1-a", "code": "82102D3111000000", "no": "ア", "kind": "item", "category": "knowledge", "text": "言葉には、相手とのつながりをつくる働きがあることに気付く"},
        {"id": "japanese-g56-K-1-i", "code": "82102D3112000000", "no": "イ", "kind": "item", "category": "knowledge", "text": "話し言葉と書き言葉との違いに気付く", "keywords": ["話し言葉と書き言葉"]},
        {"id": "japanese-g56-K-1-u", "code": "82102D3113000000", "no": "ウ", "kind": "item", "category": "knowledge", "text": "文や文章の中で漢字と仮名を適切に使い分ける。送り仮名や仮名遣いに注意して正しく書く", "keywords": ["送り仮名や仮名遣い"]},
        {"id": "japanese-g56-K-1-e", "code": "82102D3114000000", "no": "エ", "kind": "item", "category": "knowledge", "text": "第5学年と第6学年の各学年では、学年別漢字配当表の当該学年までに配当されている漢字を読む。当該学年の前の学年までに配当されている漢字を書き、文や文章の中で使う。当該学年に配当されている漢字を漸次書き、文や文章の中で使う", "keywords": ["学年別漢字配当表"]},
        {"id": "japanese-g56-K-1-o", "code": "82102D3115000000", "no": "オ", "kind": "item", "category": "knowledge", "text": "思考に関わる語句の量を増し、話や文章の中で使う。語句と語句との関係、語句の構成や変化を理解し、語彙を豊かにする。語感や言葉の使い方に対する感覚を意識して、語や語句を使う", "keywords": ["思考に関わる語句", "語彙", "語感"]},
        {"id": "japanese-g56-K-1-ka", "code": "82102D3116000000", "no": "カ", "kind": "item", "category": "knowledge", "text": "文の中での語句の係り方や語順、文と文との接続の関係、話や文章の構成や展開、話や文章の種類とその特徴を理解する"},
        {"id": "japanese-g56-K-1-ki", "code": "82102D3117000000", "no": "キ", "kind": "item", "category": "knowledge", "text": "日常よく使われる敬語を理解し、使い慣れる", "keywords": ["敬語"]},
        {"id": "japanese-g56-K-1-ku", "code": "82102D3118000000", "no": "ク", "kind": "item", "category": "knowledge", "text": "比喩や反復などの表現の工夫に気付く", "keywords": ["比喩や反復"]},
        {"id": "japanese-g56-K-1-ke", "code": "82102D3119000000", "no": "ケ", "kind": "item", "category": "knowledge", "text": "文章を音読したり朗読したりする", "keywords": ["音読", "朗読"]}
      ]},
      {"id": "japanese-g56-K-2", "code": "82102D3120000000", "no": "(2)", "kind": "section", "title": "話や文章に含まれている情報の扱い方に関する事項", "children": [
        {"id": "japanese-g56-K-2-a", "code": "82102D3121000000", "no": "ア", "kind": "item", "category": "knowledge", "text": "原因と結果など、情報と情報との関係を理解する", "keywords": ["原因と結果"]},
        {"id": "japanese-g56-K-2-i", "code": "82102D3122000000", "no": "イ", "kind": "item", "category": "knowledge", "text": "情報と情報との関係付けの仕方、図などによる語句と語句との関係の表し方を理解し使う", "keywords": ["図などによる語句と語句との関係の表し方"]}
      ]},
      {"id": "japanese-g56-K-3", "code": "82102D3130000000", "no": "(3)", "kind": "section", "title": "我が国の言語文化に関する事項", "children": [
        {"id": "japanese-g56-K-3-a", "code": "82102D3131000000", "no": "ア", "kind": "item", "category": "knowledge", "text": "親しみやすい古文や漢文、近代以降の文語調の文章を音読するなどして、言葉の響きやリズムに親しむ", "keywords": ["古文や漢文"]},
        {"id": "japanese-g56-K-3-i", "code": "82102D3132000000", "no": "イ", "kind": "item", "category": "knowledge", "text": "古典について解説した文章を読んだり、作品の内容の大体を知ったりすることを通して、昔の人のものの見方や感じ方を知る", "keywords": ["古典"]},
        {"id": "japanese-g56-K-3-u", "code": "82102D3133000000", "no": "ウ", "kind": "item", "category": "knowledge", "text": "語句の由来などに関心をもつ。時間の経過による言葉の変化や、世代による言葉の違いに気付き、共通語と方言との違いを理解する。仮名と漢字の由来、特質などを理解する", "keywords": ["共通語と方言"]},
        {"id": "japanese-g56-K-3-e", "code": "82102D3134000000", "no": "エ", "kind": "item", "category": "knowledge", "text": "書写に関する次の事項を理解し使う", "keywords": ["書写"], "children": [
          {"id": "japanese-g56-K-3-e-a", "code": "82102D3134100000", "no": "(ア)", "kind": "item", "category": "knowledge", "text": "用紙全体との関係に注意して、文字の大きさや配列などを決める。書く速さを意識して書く", "keywords": ["書く速さ"]},
          {"id": "japanese-g56-K-3-e-i", "code": "82102D3134200000", "no": "(イ)", "kind": "item", "category": "knowledge", "text": "毛筆を使用して、穂先の動きと点画のつながりを意識して書く", "keywords": ["毛筆"]},
          {"id": "japanese-g56-K-3-e-u", "code": "82102D3134300000", "no": "(ウ)", "kind": "item", "category": "knowledge", "text": "目的に応じて使用する筆記具を選び、その特徴を生かして書く", "keywords": ["筆記具"]}
        ]},
        {"id": "japanese-g56-K-3-o", "code": "82102D3135000000", "no": "オ", "kind": "item", "category": "knowledge", "text": "日常的に読書に親しみ、読書が、自分の考えを広げることに役立つことに気付く", "keywords": ["読書"]}
      ]}
    ]},
    {"id": "japanese-g56-A", "code": "82102D3210000000", "no": "A", "kind": "section", "title": "話すこと・聞くこと", "children": [
      {"id": "japanese-g56-A-1", "code": "82102D3211000000", "no": "(1)", "kind": "section", "title": "話すこと・聞くことに関する事項", "children": [
        {"id": "japanese-g56-A-1-a", "code": "82102D3211100000", "no": "ア", "kind": "item", "category": "thinking", "text": "目的や意図に応じて、日常生活の中から話題を決め、集めた材料を分類したり関係付けたりして、伝え合う内容を検討する", "keywords": ["目的や意図"]},
        {"id": "japanese-g56-A-1-i", "code": "82102D3211200000", "no": "イ", "kind": "item", "category": "thinking", "text": "話の内容が明確になるように、事実と感想、意見とを区別するなど、話の構成を考える", "keywords": ["事実と感想、意見"]},
        {"id": "japanese-g56-A-1-u", "code": "82102D3211300000", "no": "ウ", "kind": "item", "category": "thinking", "text": "資料を活用するなどして、自分の考えが伝わるように表現を工夫する", "keywords": ["資料"]},
        {"id": "japanese-g56-A-1-e", "code": "82102D3211400000", "no": "エ", "kind": "item", "category": "thinking", "text": "話し手の目的や、自分が聞こうとする意図に応じて、話の内容を捉え、話し手の考えと比較しながら、自分の考えをまとめる"},
        {"id": "japanese-g56-A-1-o", "code": "82102D3211500000", "no": "オ", "kind": "item", "category": "thinking", "text": "互いの立場や意図を明確にしながら計画的に話し合い、考えを広げたりまとめたりする", "keywords": ["計画的に話し合い"]}
      ]},
      {"id": "japanese-g56-A-2", "code": "82102D3212000000", "no": "(2)", "kind": "section", "title": "言語活動の例", "children": [
        {"id": "japanese-g56-A-2-a", "code": "82102D3212100000", "no": "ア", "kind": "activity", "text": "意見や提案など、自分の考えを話したり、それらを聞いたりする活動", "keywords": ["意見や提案"]},
        {"id": "japanese-g56-A-2-i", "code": "82102D3212200000", "no": "イ", "kind": "activity", "text": "インタビューなどをして必要な情報を集めたり、それらを発表したりする活動", "keywords": ["インタビュー"]},
        {"id": "japanese-g56-A-2-u", "code": "82102D3212300000", "no": "ウ", "kind": "activity", "text": "それぞれの立場から考えを伝えるなどして話し合う活動"}
      ]}
    ]},
    {"id": "japanese-g56-B", "code": "82102D3220000000", "no": "B", "kind": "section", "title": "書くこと", "children": [
      {"id": "japanese-g56-B-1", "code": "82102D3221000000", "no": "(1)", "kind": "section", "title": "書くことに関する事項", "children": [
        {"id": "japanese-g56-B-1-a", "code": "82102D3221100000", "no": "ア", "kind": "item", "category": "thinking", "text": "目的や意図に応じて、感じたことや考えたことなどから書くことを選び、集めた材料を分類したり関係付けたりして、伝えたいことを明確にする"},
        {"id": "japanese-g56-B-1-i", "code": "82102D3221200000", "no": "イ", "kind": "item", "category": "thinking", "text": "筋道の通った文章となるように、文章全体の構成や展開を考える", "keywords": ["筋道の通った文章"]},
        {"id": "japanese-g56-B-1-u", "code": "82102D3221300000", "no": "ウ", "kind": "item", "category": "thinking", "text": "目的や意図に応じて、簡単に書いたり詳しく書いたりする。事実と感想、意見とを区別して書くなど、自分の考えが伝わるように書き表し方を工夫する", "keywords": ["事実と感想、意見"]},
        {"id": "japanese-g56-B-1-e", "code": "82102D3221400000", "no": "エ", "kind": "item", "category": "thinking", "text": "引用したり、図表やグラフなどを用いたりして、自分の考えが伝わるように書き表し方を工夫する", "keywords": ["引用", "図表やグラフ"]},
        {"id": "japanese-g56-B-1-o", "code": "82102D3221500000", "no": "オ", "kind": "item", "category": "thinking", "text": "文章全体の構成や書き表し方などに着目して、文や文章を整える"},
        {"id": "japanese-g56-B-1-ka", "code": "82102D3221600000", "no": "カ", "kind": "item", "category": "thinking", "text": "文章全体の構成や展開が明確になっているかなど、文章に対する感想や意見を伝え合い、自分の文章のよいところを見付ける"}
      ]},
      {"id": "japanese-g56-B-2", "code": "82102D3222000000", "no": "(2)", "kind": "section", "title": "言語活動の例", "children": [
        {"id": "japanese-g56-B-2-a", "code": "82102D3222100000", "no": "ア", "kind": "activity", "text": "事象を説明したり意見を述べたりするなど、考えたことや伝えたいことを書く活動"},
        {"id": "japanese-g56-B-2-i", "code": "82102D3222200000", "no": "イ", "kind": "activity", "text": "短歌や俳句をつくるなど、感じたことや想像したことを書く活動", "keywords": ["短歌や俳句"]},
        {"id": "japanese-g56-B-2-u", "code": "82102D3222300000", "no": "ウ", "kind": "activity", "text": "事実や経験を基に、感じたり考えたりしたことや、自分にとっての意味について文章に書く活動"}
      ]}
    ]},
    {"id": "japanese-g56-C", "code": "82102D3230000000", "no": "C", "kind": "section", "title": "読むこと", "children": [
      {"id": "japanese-g56-C-1", "code": "82102D3231000000", "no": "(1)", "kind": "section", "title": "読むことに関する事項", "children": [
        {"id": "japanese-g56-C-1-a", "code": "82102D3231100000", "no": "ア", "kind": "item", "category": "thinking", "text": "事実と感想、意見などとの関係を叙述を基に押さえ、文章全体の構成を捉えて要旨を把握する", "keywords": ["要旨"]},
        {"id": "japanese-g56-C-1-i", "code": "82102D3231200000", "no": "イ", "kind": "item", "category": "thinking", "text": "登場人物の相互関係や心情などを、描写を基に捉える", "keywords": ["相互関係や心情"]},
        {"id": "japanese-g56-C-1-u", "code": "82102D3231300000", "no": "ウ", "kind": "item", "category": "thinking", "text": "目的に応じて、文章と図表などを結び付けるなどして必要な情報を見付けたり、論の進め方について考えたりする", "keywords": ["論の進め方"]},
        {"id": "japanese-g56-C-1-e", "code": "82102D3231400000", "no": "エ", "kind": "item", "category": "thinking", "text": "人物像や物語などの全体像を具体的に想像したり、表現の効果を考えたりする", "keywords": ["人物像", "表現の効果"]},
        {"id": "japanese-g56-C-1-o", "code": "82102D3231500000", "no": "オ", "kind": "item", "category": "thinking", "text": "文章を読んで理解したことに基づいて、自分の考えをまとめる"},
        {"id": "japanese-g56-C-1-ka", "code": "82102D3231600000", "no": "カ", "kind": "item", "category": "thinking", "text": "文章を読んでまとめた意見や感想を共有し、自分の考えを広げる"}
      ]},
      {"id": "japanese-g56-C-2", "code": "82102D3232000000", "no": "(2)", "kind": "section", "title": "言語活動の例", "children": [
        {"id": "japanese-g56-C-2-a", "code": "82102D3232100000", "no": "ア", "kind": "activity", "text": "説明や解説などの文章を比較するなどして読み、分かったことや考えたことを、話し合ったり文章にまとめたりする活動"},
        {"id": "japanese-g56-C-2-i", "code": "82102D3232200000", "no": "イ", "kind": "activity", "text": "詩や物語、伝記などを読み、内容を説明したり、自分の生き方などについて考えたことを伝え合ったりする活動", "keywords": ["伝記"]},
        {"id": "japanese-g56-C-2-u", "code": "82102D3232300000", "no": "ウ", "kind": "activity", "text": "学校図書館などを利用し、複数の本や新聞などを活用して、調べたり考えたりしたことを報告する活動"}
      ]}
    ]}
  ]
}
