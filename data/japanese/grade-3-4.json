{
  "id": "japanese-g34",
  "subject": "japanese",
  "grades": [3, 4],
  "name": "第3学年及び第4学年",
  "code": "82102C0000000000",
  "goals": [
    {"id": "japanese-g34-goal-1", "code": "82102C2100000000", "no": "(1)", "kind": "goal", "category": "knowledge", "text": "日常生活に必要な国語の知識や技能を身に付ける。我が国の言語文化に親しんだり理解したりできるようにする"},
    {"id": "japanese-g34-goal-2", "code": "82102C2200000000", "no": "(2)", "kind": "goal", "category": "thinking", "text": "筋道立てて考える力や、豊かに感じたり想像したりする力を養う。日常生活における人との関わりの中で伝え合う力を高め、自分の思いや考えをまとめることができるようにする", "keywords": ["筋道立てて考える力"]},
    {"id": "japanese-g34-goal-3", "code": "82102C2300000000", "no": "(3)", "kind": "goal", "category": "attitude", "text": "言葉がもつよさに気付き、幅広く読書をする。国語を大切にして、思いや考えを伝え合おうとする態度を養う"}
  ],
  "contents": [
    {"id": "japanese-g34-K", "code": "82102C3100000000", "no": "", "kind": "section", "title": "知識及び技能", "children": [
      {"id": "japanese-g34-K-1", "code": "82102C3110000000", "no": "(1)", "kind": "section", "title": "言葉の特徴や使い方に関する事項", "children": [
        {"id": "japanese-g34-K-1-a", "code": "82102C3111000000", "no": "ア", "kind": "item", "category": "knowledge", "text": "言葉には、考えたことや思ったことを表す働きがあることに気付く"},
        {"id": "japanese-g34-K-1-i", "code": "82102C3112000000", "no": "イ", "kind": "item", "category": "knowledge", "text": "相手を見て話したり聞いたりする。言葉の抑揚や強弱、間の取り方などに注意して話す", "keywords": ["抑揚や強弱、間の取り方"]},
        {"id": "japanese-g34-K-1-u", "code": "82102C3113000000", "no": "ウ", "kind": "item", "category": "knowledge", "text": "漢字と仮名を用いた表記、送り仮名の付け方、改行の仕方を理解して、文や文章の中で使う。句読点を適切に打つ。第3学年では、日常使われている簡単な単語について、ローマ字で表記されたものを読み、ローマ字で書く", "keywords": ["送り仮名", "改行", "ローマ字"]},
        {"id": "japanese-g34-K-1-e", "code": "82102C3114000000", "no": "エ", "kind": "item", "category": "knowledge", "text": "第3学年と第4学年の各学年では、学年別漢字配当表の当該学年までに配当されている漢字を読む。当該学年の前の学年までに配当されている漢字を書き、文や文章の中で使う。当該学年に配当されている漢字を漸次書き、文や文章の中で使う", "keywords": ["学年別漢字配当表"]},
        {"id": "japanese-g34-K-1-o", "code": "82102C3115000000", "no": "オ", "kind": "item", "category": "knowledge", "text": "様子や行動、気持ちや性格を表す語句の量を増し、話や文章の中で使う。言葉には性質や役割による語句のまとまりがあることを理解し、語彙を豊かにする", "keywords": ["様子や行動、気持ちや性格", "語彙"]},
        {"id": "japanese-g34-K-1-ka", "code": "82102C3116000000", "no": "カ", "kind": "item", "category": "knowledge", "text": "主語と述語との関係、修飾と被修飾との関係、指示する語句と接続する語句の役割、段落の役割を理解する", "keywords": ["修飾と被修飾", "指示する語句と接続する語句", "段落"]},
        {"id": "japanese-g34-K-1-ki", "code": "82102C3117000000", "no": "キ", "kind": "item", "category": "knowledge", "text": "丁寧な言葉を使う。敬体と常体との違いに注意しながら書く", "keywords": ["敬体と常体"]},
        {"id": "japanese-g34-K-1-ku", "code": "82102C3118000000", "no": "ク", "kind": "item", "category": "knowledge", "text": "文章全体の構成や内容の大体を意識しながら音読する", "keywords": ["音読"]}
      ]},
      {"id": "japanese-g34-K-2", "code": "82102C3120000000", "no": "(2)", "kind": "section", "title": "話や文章に含まれている情報の扱い方に関する事項", "children": [
        {"id": "japanese-g34-K-2-a", "code": "82102C3121000000", "no": "ア", "kind": "item", "category": "knowledge", "text": "考えとそれを支える理由や事例、全体と中心など、情報と情報との関係を理解する", "keywords": ["考えとそれを支える理由や事例", "全体と中心"]},
        {"id": "japanese-g34-K-2-i", "code": "82102C3122000000", "no": "イ", "kind": "item", "category": "knowledge", "text": "比較や分類の仕方、必要な語句などの書き留め方、引用の仕方や出典の示し方、辞書や事典の使い方を理解し使う", "keywords": ["比較や分類", "引用", "出典", "辞書や事典"]}
      ]},
      {"id": "japanese-g34-K-3", "code": "82102C3130000000", "no": "(3)", "kind": "section", "title": "我が国の言語文化に関する事項", "children": [
        {"id": "japanese-g34-K-3-a", "code": "82102C3131000000", "no": "ア", "kind": "item", "category": "knowledge", "text": "易しい文語調の短歌や俳句を音読したり暗唱したりするなどして、言葉の響きやリズムに親しむ", "keywords": ["短歌や俳句"]},
        {"id": "japanese-g34-K-3-i", "code": "82102C3132000000", "no": "イ", "kind": "item", "category": "knowledge", "text": "長い間使われてきたことわざや慣用句、故事成語などの意味を知り、使う", "keywords": ["ことわざや慣用句、故事成語"]},
        {"id": "japanese-g34-K-3-u", "code": "82102C3133000000", "no": "ウ", "kind": "item", "category": "knowledge", "text": "漢字が、へんやつくりなどから構成されていることを理解する", "keywords": ["へんやつくり"]},
        {"id": "japanese-g34-K-3-e", "code": "82102C3134000000", "no": "エ", "kind": "item", "category": "knowledge", "text": "書写に関する次の事項を理解し使う", "keywords": ["書写"], "children": [
          {"id": "japanese-g34-K-3-e-a", "code": "82102C3134100000", "no": "(ア)", "kind": "item", "category": "knowledge", "text": "文字の組立て方を理解し、形を整えて書く", "keywords": ["組立て方"]},
          {"id": "japanese-g34-K-3-e-i", "code": "82102C3134200000", "no": "(イ)", "kind": "item", "category": "knowledge", "text": "漢字や仮名の大きさ、配列に注意して書く", "keywords": ["大きさ、配列"]},
          {"id": "japanese-g34-K-3-e-u", "code": "82102C3134300000", "no": "(ウ)", "kind": "item", "category": "knowledge", "text": "毛筆を使用して点画の書き方への理解を深め、筆圧などに注意して書く", "keywords": ["毛筆"]}
        ]},
        {"id": "japanese-g34-K-3-o", "code": "82102C3135000000", "no": "オ", "kind": "item", "category": "knowledge", "text": "幅広く読書に親しみ、読書が、必要な知識や情報を得ることに役立つことに気付く", "keywords": ["読書"]}
      ]}
    ]},
    {"id": "japanese-g34-A", "code": "82102C3210000000", "no": "A", "kind": "section", "title": "話すこと・聞くこと", "children": [
      {"id": "japanese-g34-A-1", "code": "82102C3211000000", "no": "(1)", "kind": "section", "title": "話すこと・聞くことに関する事項", "children": [
        {"id": "japanese-g34-A-1-a", "code": "82102C3211100000", "no": "ア", "kind": "item", "category": "thinking", "text": "目的を意識して、日常生活の中から話題を決め、集めた材料を比較したり分類したりして、伝え合うために必要な事柄を選ぶ", "keywords": ["目的"]},
        {"id": "japanese-g34-A-1-i", "code": "82102C3211200000", "no": "イ", "kind": "item", "category": "thinking", "text": "相手に伝わるように、理由や事例などを挙げながら、話の中心が明確になるよう話の構成を考える", "keywords": ["話の中心"]},
        {"id": "japanese-g34-A-1-u", "code": "82102C3211300000", "no": "ウ", "kind": "item", "category": "thinking", "text": "話の中心や話す場面を意識して、言葉の抑揚や強弱、間の取り方などを工夫する"},
        {"id": "japanese-g34-A-1-e", "code": "82102C3211400000", "no": "エ", "kind": "item", "category": "thinking", "text": "必要なことを記録したり質問したりしながら聞き、話し手が伝えたいことや自分が聞きたいことの中心を捉え、自分の考えをもつ", "keywords": ["記録したり質問したり"]},
        {"id": "japanese-g34-A-1-o", "code": "82102C3211500000", "no": "オ", "kind": "item", "category": "thinking", "text": "目的や進め方を確認し、司会などの役割を果たしながら話し合い、互いの意見の共通点や相違点に着目して、考えをまとめる", "keywords": ["司会などの役割"]}
      ]},
      {"id": "japanese-g34-A-2", "code": "82102C3212000000", "no": "(2)", "kind": "section", "title": "言語活動の例", "children": [
        {"id": "japanese-g34-A-2-a", "code": "82102C3212100000", "no": "ア", "kind": "activity", "text": "説明や報告など、調べたことを話したり、それらを聞いたりする活動", "keywords": ["説明や報告"]},
        {"id": "japanese-g34-A-2-i", "code": "82102C3212200000", "no": "イ", "kind": "activity", "text": "質問するなどして情報を集めたり、それらを発表したりする活動", "keywords": ["発表"]},
        {"id": "japanese-g34-A-2-u", "code": "82102C3212300000", "no": "ウ", "kind": "activity", "text": "互いの考えを伝えるなどして、グループや学級全体で話し合う活動", "keywords": ["グループや学級全体で話し合う"]}
      ]}
    ]},
    {"id": "japanese-g34-B", "code": "82102C3220000000", "no": "B", "kind": "section", "title": "書くこと", "children": [
      {"id": "japanese-g34-B-1", "code": "82102C3221000000", "no": "(1)", "kind": "section", "title": "書くことに関する事項", "children": [
        {"id": "japanese-g34-B-1-a", "code": "82102C3221100000", "no": "ア", "kind": "item", "category": "thinking", "text": "相手や目的を意識して、経験したことや想像したことなどから書くことを選び、集めた材料を比較したり分類したりして、伝えたいことを明確にする", "keywords": ["相手や目的"]},
        {"id": "japanese-g34-B-1-i", "code": "82102C3221200000", "no": "イ", "kind": "item", "category": "thinking", "text": "書く内容の中心を明確にし、内容のまとまりで段落をつくったり、段落相互の関係に注意したりして、文章の構成を考える", "keywords": ["段落"]},
        {"id": "japanese-g34-B-1-u", "code": "82102C3221300000", "no": "ウ", "kind": "item", "category": "thinking", "text": "自分の考えと、それを支える理由や事例との関係を明確にして、書き表し方を工夫する"},
        {"id": "japanese-g34-B-1-e", "code": "82102C3221400000", "no": "エ", "kind": "item", "category": "thinking", "text": "間違いを正したり、相手や目的を意識した表現になっているかを確かめたりして、文や文章を整える"},
        {"id": "japanese-g34-B-1-o", "code": "82102C3221500000", "no": "オ", "kind": "item", "category": "thinking", "text": "書こうとしたことが明確になっているかなど、文章に対する感想や意見を伝え合い、自分の文章のよいところを見付ける"}
      ]},
      {"id": "japanese-g34-B-2", "code": "82102C3222000000", "no": "(2)", "kind": "section", "title": "言語活動の例", "children": [
        {"id": "japanese-g34-B-2-a", "code": "82102C3222100000", "no": "ア", "kind": "activity", "text": "調べたことをまとめて報告するなど、事実やそれを基に考えたことを書く活動", "keywords": ["報告"]},
        {"id": "japanese-g34-B-2-i", "code": "82102C3222200000", "no": "イ", "kind": "activity", "text": "行事の案内やお礼の文章を書くなど、伝えたいことを手紙に書く活動", "keywords": ["手紙"]},
        {"id": "japanese-g34-B-2-u", "code": "82102C3222300000", "no": "ウ", "kind": "activity", "text": "詩や物語をつくるなど、感じたことや想像したことを書く活動", "keywords": ["詩や物語"]}
      ]}
    ]},
    {"id": "japanese-g34-C", "code": "82102C3230000000", "no": "C", "kind": "section", "title": "読むこと", "children": [
      {"id": "japanese-g34-C-1", "code": "82102C3231000000", "no": "(1)", "kind": "section", "title": "読むことに関する事項", "children": [
        {"id": "japanese-g34-C-1-a", "code": "82102C3231100000", "no": "ア", "kind": "item", "category": "thinking", "text": "段落相互の関係に着目しながら、考えとそれを支える理由や事例との関係などを、叙述を基に捉える", "keywords": ["段落相互の関係"]},
        {"id": "japanese-g34-C-1-i", "code": "82102C3231200000", "no": "イ", "kind": "item", "category": "thinking", "text": "登場人物の行動や気持ちなどを、叙述を基に捉える", "keywords": ["行動や気持ち"]},
        {"id": "japanese-g34-C-1-u", "code": "82102C3231300000", "no": "ウ", "kind": "item", "category": "thinking", "text": "目的を意識して、中心となる語や文を見付けて要約する", "keywords": ["要約"]},
        {"id": "japanese-g34-C-1-e", "code": "82102C3231400000", "no": "エ", "kind": "item", "category": "thinking", "text": "登場人物の気持ちの変化や性格、情景を、場面の移り変わりと結び付けて具体的に想像する"},
        {"id": "japanese-g34-C-1-o", "code": "82102C3231500000", "no": "オ", "kind": "item", "category": "thinking", "text": "文章を読んで理解したことに基づいて、感想や考えをもつ"},
        {"id": "japanese-g34-C-1-ka", "code": "82102C3231600000", "no": "カ", "kind": "item", "category": "thinking", "text": "文章を読んで感じたことや考えたことを共有し、一人一人の感じ方などに違いがあることに気付く"}
      ]},
      {"id": "japanese-g34-C-2", "code": "82102C3232000000", "no": "(2)", "kind": "section", "title": "言語活動の例", "children": [
        {"id": "japanese-g34-C-2-a", "code": "82102C3232100000", "no": "ア", "kind": "activity", "text": "記録や報告などの文章を読み、文章の一部を引用して、分かったことや考えたことを説明したり、意見を述べたりする活動", "keywords": ["引用"]},
        {"id": "japanese-g34-C-2-i", "code": "82102C3232200000", "no": "イ", "kind": "activity", "text": "詩や物語などを読み、内容を説明したり、考えたことなどを伝え合ったりする活動"},
        {"id": "japanese-g34-C-2-u", "code": "82102C3232300000", "no": "ウ", "kind": "activity", "text": "学校図書館などを利用し、事典や図鑑などから情報を得て、分かったことなどをまとめて説明する活動"}
      ]}
    ]}
  ]
}
